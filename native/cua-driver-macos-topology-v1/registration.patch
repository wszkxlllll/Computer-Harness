+        if CFGetTypeID(*value)!=CFDictionary::<*const c_void,*const c_void>::type_id(){return Err("selected_identity_cg_order_unknown");}
+        let dict=CFDictionary::<*const c_void,*const c_void>::wrap_under_get_rule(*value as _);
