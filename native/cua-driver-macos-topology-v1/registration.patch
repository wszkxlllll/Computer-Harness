+fn write_step(command:&Command,write:impl FnOnce()->bool)->Result<(),&'static str> {
+    command.alive()?;command.started.store(true,Ordering::SeqCst);
+    if write(){Ok(())}else{Err("bootstrap_activation_unconfirmed")}
