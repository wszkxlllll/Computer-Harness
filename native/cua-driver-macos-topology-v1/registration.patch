+    root_fields(false,||Ok(reader.pid(window)?==pid),|key|names.contains(key))?;
+    let kind=identity_kind(&reader.string(window,"AXRole")?,&reader.string(window,"AXSubrole")?)?;
+    let parent=reader.element(window,"AXParent")?;
