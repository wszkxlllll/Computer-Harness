+#[derive(Debug, Clone, PartialEq)]
+pub(super) struct CgIdentity { pid:i32, window_id:u32, layer:i32, bounds:[f64;4] }
+impl CgIdentity {pub(super) fn task_bounds(&self)->[f64;4]{self.bounds}}
