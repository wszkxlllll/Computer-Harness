     /// This trust marker is independent of actionable ancestry because
     /// AXWebArea is commonly non-actionable and therefore has no element index.
     pub in_web_content: bool,
+    /// Format-only metadata for an exact native AXTextArea CFString value.
+    /// This is omitted for web content, non-string values, and unavailable AXValue.
+    pub text_format: Option<AXTextFormat>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct AXTextFormat {
+    pub source: &'static str,
+    pub status: &'static str,
+    pub utf8_bytes: Option<usize>,
+    pub code_point_count: Option<usize>,
+    pub line_feed_count: Option<usize>,
+    pub trailing_line_feed_count: Option<usize>,
+    pub carriage_return_count: Option<usize>,
+}
+
+const AX_TEXT_FORMAT_MAX_UTF8_BYTES: usize = 16_384;
+
+fn ax_text_format(value: &str) -> AXTextFormat {
+    if value.len() > AX_TEXT_FORMAT_MAX_UTF8_BYTES {
+        return AXTextFormat {
+            source: "ax-cfstring-v1",
+            status: "over_limit",
+            utf8_bytes: None,
+            code_point_count: None,
+            line_feed_count: None,
+            trailing_line_feed_count: None,
+            carriage_return_count: None,
+        };
+    }
+    let line_feed_count = value.bytes().filter(|byte| *byte == b'\n').count();
+    let trailing_line_feed_count = value
+        .bytes()
+        .rev()
+        .take_while(|byte| *byte == b'\n')
+        .count();
+    AXTextFormat {
+        source: "ax-cfstring-v1",
+        status: "complete",
+        utf8_bytes: Some(value.len()),
+        code_point_count: Some(value.chars().count()),
+        line_feed_count: Some(line_feed_count),
+        trailing_line_feed_count: Some(trailing_line_feed_count),
+        carriage_return_count: Some(value.bytes().filter(|byte| *byte == b'\r').count()),
+    }
 }
 
+fn ax_text_format_for_element(
+    role: &str,
+    in_web_content: bool,
+    value: Option<&str>,
+) -> Option<AXTextFormat> {
+    if role != "AXTextArea" || in_web_content {
+        return None;
+    }
+    value.map(ax_text_format)
+}
