+    #[test]
+    fn ax_text_format_counts_exact_cfstring_format_without_retaining_text() {
+        let empty = ax_text_format("");
+        assert_eq!(empty.utf8_bytes, Some(0));
+        assert_eq!(empty.code_point_count, Some(0));
+        assert_eq!(empty.line_feed_count, Some(0));
+        assert_eq!(empty.trailing_line_feed_count, Some(0));
+
+        let only_line_feed = ax_text_format("\n");
+        assert_eq!(only_line_feed.utf8_bytes, Some(1));
+        assert_eq!(only_line_feed.line_feed_count, Some(1));
+        assert_eq!(only_line_feed.trailing_line_feed_count, Some(1));
+
+        let unicode = ax_text_format("雪😀\n");
+        assert_eq!(unicode.utf8_bytes, Some(8));
+        assert_eq!(unicode.code_point_count, Some(3));
+        assert_eq!(unicode.line_feed_count, Some(1));
+        assert_eq!(unicode.trailing_line_feed_count, Some(1));
+
+        let crlf = ax_text_format("x\r\n\n");
+        assert_eq!(crlf.utf8_bytes, Some(4));
+        assert_eq!(crlf.code_point_count, Some(4));
+        assert_eq!(crlf.line_feed_count, Some(2));
+        assert_eq!(crlf.trailing_line_feed_count, Some(2));
+        assert_eq!(crlf.carriage_return_count, Some(1));
+
+        let at_limit = ax_text_format(&"a".repeat(AX_TEXT_FORMAT_MAX_UTF8_BYTES));
+        assert_eq!(at_limit.status, "complete");
+        assert_eq!(at_limit.utf8_bytes, Some(AX_TEXT_FORMAT_MAX_UTF8_BYTES));
+        let over_limit = ax_text_format(&"a".repeat(AX_TEXT_FORMAT_MAX_UTF8_BYTES + 1));
+        assert_eq!(over_limit.status, "over_limit");
+        assert_eq!(over_limit.utf8_bytes, None);
+        assert_eq!(over_limit.code_point_count, None);
     }
