+fn window_capture_configuration(
+    width: u32,
+    height: u32,
+) -> screencapturekit::prelude::SCStreamConfiguration {
+    // Each registered window has its own WindowServer frame. Including child
+    // windows can composite an attached sheet with its parent and then resize
+    // that family image into the selected window's dimensions.
+    screencapturekit::prelude::SCStreamConfiguration::new()
+        .with_width(width)
+        .with_height(height)
+        .with_includes_child_windows(false)
+}
