+/// Return the actual bundle/executable identity for one app process and the
+/// complete live NSRunningApplication set for its bundle. Any unreadable
+/// process lifetime or executable identity makes the result unavailable.
+pub(crate) fn document_app_identity(
+    pid: i32,
+    expected_bundle_id: &str,
+) -> Option<serde_json::Value> {
+    use objc2_app_kit::NSRunningApplication;
+    use objc2_foundation::NSString;
+
+    if pid <= 0 {
+        return None;
+    }
+    let target = unsafe { NSRunningApplication::runningApplicationWithProcessIdentifier(pid) }?;
+    if unsafe { target.isTerminated() } {
+        return None;
+    }
+    let target_bundle_id = unsafe { target.bundleIdentifier() }?.to_string();
+    let target_executable_url = unsafe { target.executableURL() }?;
+    if !unsafe { target_executable_url.isFileURL() } {
+        return None;
+    }
+    let target_executable_url = unsafe { target_executable_url.absoluteString() }?.to_string();
+    let target_start = crate::ax::enablement::process_start_stamp(pid)?;
+
+    let bundle = NSString::from_str(expected_bundle_id);
+    let running = unsafe { NSRunningApplication::runningApplicationsWithBundleIdentifier(&bundle) };
+    let mut instances = Vec::new();
+    let mut target_instance_matches = false;
+    unsafe {
+        for index in 0..running.count() {
+            let app = running.objectAtIndex(index);
+            if app.isTerminated() {
+                continue;
+            }
+            let instance_pid = app.processIdentifier();
+            if instance_pid <= 0 {
+                return None;
+            }
+            let actual_bundle = app.bundleIdentifier()?.to_string();
+            let executable_url = app.executableURL()?;
+            if !executable_url.isFileURL() {
+                return None;
+            }
+            let executable = executable_url.absoluteString()?.to_string();
+            let start = crate::ax::enablement::process_start_stamp(instance_pid)?;
+            if instance_pid == pid {
+                target_instance_matches = start == target_start
+                    && actual_bundle == target_bundle_id
+                    && executable == target_executable_url;
+            }
+            instances.push(serde_json::json!({
+                "pid": instance_pid,
+                "bundle_id": actual_bundle,
+                "executable_url": executable,
+                "process_start": { "seconds": start.0, "microseconds": start.1 },
+            }));
+        }
+    }
+    instances.sort_by_key(|row| {
+        row.get("pid")
+            .and_then(serde_json::Value::as_i64)
+            .unwrap_or_default()
+    });
+    let identity = serde_json::json!({
+        "status": "complete",
+        "expected_bundle_identifier": expected_bundle_id,
+        "target_bundle_id": target_bundle_id,
+        "target_executable_url": target_executable_url,
+        "target_process_start": { "seconds": target_start.0, "microseconds": target_start.1 },
+        "target_instance_matches": target_instance_matches,
+        "instances": instances,
+    });
+    document_app_identity_is_exact(&identity, pid, expected_bundle_id).then_some(identity)
+}
+
+pub(crate) fn document_app_identity_is_exact(
+    identity: &serde_json::Value,
+    pid: i32,
+    expected_bundle_id: &str,
+) -> bool {
+    let Some(instances) = identity
+        .get("instances")
+        .and_then(serde_json::Value::as_array)
+    else {
+        return false;
+    };
+    if identity.get("status").and_then(serde_json::Value::as_str) != Some("complete")
+        || identity
+            .get("expected_bundle_identifier")
+            .and_then(serde_json::Value::as_str)
+            != Some(expected_bundle_id)
+        || identity
+            .get("target_bundle_id")
+            .and_then(serde_json::Value::as_str)
+            != Some(expected_bundle_id)
+        || identity
+            .get("target_executable_url")
+            .and_then(serde_json::Value::as_str)
+            .is_none_or(str::is_empty)
+        || identity
+            .get("target_instance_matches")
+            .and_then(serde_json::Value::as_bool)
+            != Some(true)
+        || instances.len() != 1
+    {
+        return false;
+    }
+    let instance = &instances[0];
+    instance.get("pid").and_then(serde_json::Value::as_i64) == Some(i64::from(pid))
+        && instance
+            .get("bundle_id")
+            .and_then(serde_json::Value::as_str)
+            == Some(expected_bundle_id)
+        && instance
+            .get("executable_url")
+            .and_then(serde_json::Value::as_str)
+            == identity
+                .get("target_executable_url")
+                .and_then(serde_json::Value::as_str)
+        && instance.get("process_start") == identity.get("target_process_start")
+}
+
+pub(crate) fn document_app_identity_is_stable(
+    initial: &serde_json::Value,
+    tail: Option<&serde_json::Value>,
+    pid: i32,
+    expected_bundle_id: &str,
+) -> bool {
+    document_app_identity_is_exact(initial, pid, expected_bundle_id)
+        && tail == Some(initial)
+        && tail.is_some_and(|value| document_app_identity_is_exact(value, pid, expected_bundle_id))
 }
 
