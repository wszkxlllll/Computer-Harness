+enum CheckedElementRead {
+    Value(crate::ax::bindings::AXUIElementRef),
+    Missing,
+    Unsupported(i32),
+    ReadError(i32),
+    WrongType(core_foundation::base::CFTypeID),
+}
+
+unsafe fn copy_element_attr_checked(
+    element: crate::ax::bindings::AXUIElementRef,
+    attr_name: &str,
+) -> CheckedElementRead {
+    use crate::ax::bindings::{
+        kAXErrorAttributeUnsupported, kAXErrorNoValue, kAXErrorSuccess,
+        AXUIElementCopyAttributeValue, AXUIElementGetTypeID,
+    };
+    use core_foundation::{
+        base::{CFGetTypeID, CFRelease, CFTypeRef, TCFType},
+        string::CFString,
+    };
+
+    let attr = CFString::new(attr_name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        return if error == kAXErrorNoValue {
+            CheckedElementRead::Missing
+        } else if error == kAXErrorAttributeUnsupported {
+            CheckedElementRead::Unsupported(error)
+        } else if error == kAXErrorSuccess {
+            CheckedElementRead::ReadError(-25200)
+        } else {
+            CheckedElementRead::ReadError(error)
+        };
+    }
+    let type_id = CFGetTypeID(value);
+    if type_id == AXUIElementGetTypeID() {
+        CheckedElementRead::Value(value as _)
+    } else {
+        CFRelease(value);
+        CheckedElementRead::WrongType(type_id)
+    }
+}
+
+fn checked_element_read_json(value: &CheckedElementRead) -> Value {
+    match value {
+        CheckedElementRead::Value(_) => serde_json::json!({ "status": "ok", "type": "ax_element" }),
+        CheckedElementRead::Missing => serde_json::json!({ "status": "missing" }),
+        CheckedElementRead::Unsupported(error) => {
+            serde_json::json!({ "status": "unsupported", "ax_error": error })
+        }
+        CheckedElementRead::ReadError(error) => {
+            serde_json::json!({ "status": "read_error", "ax_error": error })
+        }
+        CheckedElementRead::WrongType(type_id) => {
+            serde_json::json!({ "status": "wrong_type", "cf_type_id": type_id })
+        }
+    }
+}
