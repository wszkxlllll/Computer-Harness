+/// Re-read the complete per-application AXWindows domain without retaining or
+/// serializing document URL values. Used at the end of proof construction so a
+/// new matching document, changed AXDocument state, or unreadable row invalidates
+/// the initial uniqueness result.
+unsafe fn read_document_domain_projection(
+    app: crate::ax::bindings::AXUIElementRef,
+    expected_pid: i32,
+    expected_url: Option<&str>,
+) -> Option<(Vec<Value>, Vec<u32>, bool)> {
+    use crate::ax::bindings::{
+        copy_attribute_names_checked, copy_ax_document_checked, copy_element_array_attr_checked,
+        copy_string_attr_checked, kAXErrorSuccess, AXDocumentValue, AXUIElementGetPid,
+        CheckedAxValue,
+    };
+    use core_foundation::base::{CFRelease, CFTypeRef};
+
+    let windows = copy_element_array_attr_checked(app, "AXWindows").ok()?;
+    let mut rows = Vec::new();
+    let mut matching_ids = Vec::new();
+    let mut ids = std::collections::HashSet::new();
+    let mut complete = true;
+    let mut roles_read = true;
+    for candidate in &windows {
+        let role = match copy_string_attr_checked(*candidate, "AXRole") {
+            Ok(role) if !role.trim().is_empty() => role,
+            _ => {
+                roles_read = false;
+                break;
+            }
+        };
+        if role != "AXWindow" {
+            complete = false;
+            continue;
+        }
+        let mut candidate_pid = 0;
+        if AXUIElementGetPid(*candidate, &mut candidate_pid) != kAXErrorSuccess
+            || candidate_pid != expected_pid
+        {
+            complete = false;
+        }
+        let Some(candidate_id) = crate::ax::bindings::ax_get_window_id(*candidate) else {
+            complete = false;
+            continue;
+        };
+        if !ids.insert(candidate_id) {
+            complete = false;
+        }
+        let document = copy_ax_document_checked(*candidate);
+        let document_row = match document {
+            CheckedAxValue::Value(AXDocumentValue::CFUrl(value)) => {
+                let matches = expected_url.is_some_and(|expected| value == expected);
+                if matches {
+                    matching_ids.push(candidate_id);
+                }
+                serde_json::json!({ "status": "ok", "type": "cf_url", "matches_expected": matches })
+            }
+            CheckedAxValue::Value(AXDocumentValue::CFString(value)) => {
+                let matches = expected_url.is_some_and(|expected| value == expected);
+                if matches {
+                    matching_ids.push(candidate_id);
+                }
+                serde_json::json!({ "status": "ok", "type": "cf_string", "matches_expected": matches })
+            }
+            CheckedAxValue::Missing => serde_json::json!({ "status": "missing" }),
+            CheckedAxValue::Unsupported(error) => match copy_attribute_names_checked(*candidate) {
+                Ok(names) if !names.iter().any(|name| name == "AXDocument") => {
+                    serde_json::json!({ "status": "absent", "ax_error": error })
+                }
+                _ => {
+                    complete = false;
+                    serde_json::json!({ "status": "unknown" })
+                }
+            },
+            CheckedAxValue::ReadError(_) | CheckedAxValue::WrongType(_) => {
+                complete = false;
+                serde_json::json!({ "status": "unknown" })
+            }
+        };
+        rows.push(serde_json::json!({
+            "window_id": candidate_id,
+            "role": "AXWindow",
+            "document": document_row,
+        }));
+    }
+    for candidate in windows {
+        CFRelease(candidate as CFTypeRef);
+    }
+    if !roles_read {
+        return None;
+    }
+    Some((rows, matching_ids, complete))
+}
 
