+fn parse_document_identity_query(args: &Value) -> Result<Option<Option<String>>, &'static str> {
+    let Some(query) = args.get("document_identity_query") else {
+        return Ok(None);
+    };
+    let Some(object) = query.as_object() else {
+        return Err("document_identity_query must be an object");
+    };
+    if object.len() > 1 || object.keys().any(|key| key != "expected_document_url") {
+        return Err("document_identity_query accepts only expected_document_url");
+    }
+    if object.is_empty() {
+        return Ok(Some(None));
+    }
+    let Some(url) = object.get("expected_document_url").and_then(Value::as_str) else {
+        return Err("document_identity_query.expected_document_url must be a string");
+    };
+    if url.len() > 8192
+        || !url.starts_with("file:///")
+        || url.chars().any(char::is_control)
+        || url.contains('?')
+        || url.contains('#')
+    {
+        return Err(
+            "document_identity_query.expected_document_url must be a canonical local file URL",
+        );
+    }
+    Ok(Some(Some(url.to_owned())))
+}
