+/// Copy an AX attribute-name list, preserving API/type errors instead of
+/// treating them as an empty set. Used only to distinguish a genuinely absent
+/// `AXDocument` attribute from an unreadable document value.
+///
+/// # Safety
+/// `element` must remain valid for the duration of the AX call.
+pub unsafe fn copy_attribute_names_checked(
+    element: AXUIElementRef,
+) -> Result<Vec<String>, AXError> {
+    let mut value: CFArrayRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeNames(element, &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value as CFTypeRef);
+        }
+        return Err(if error == kAXErrorSuccess {
+            kAXErrorFailure
+        } else {
+            error
+        });
+    }
+    if core_foundation::base::CFGetTypeID(value as CFTypeRef) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value as CFTypeRef);
+        return Err(kAXErrorFailure);
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value);
+    let mut names = Vec::with_capacity(array.len() as usize);
+    for index in 0..array.len() {
+        let Some(item_ref) = array.get(index) else {
+            return Err(kAXErrorFailure);
+        };
+        let item = *item_ref;
+        if item.is_null() || core_foundation::base::CFGetTypeID(item) != CFStr::type_id() {
+            return Err(kAXErrorFailure);
+        }
+        names.push(CFStr::wrap_under_get_rule(item as _).to_string());
+    }
+    Ok(names)
+}
