+}
+
+fn stable_unique_document_domain(
+    initial_complete: bool,
+    initial_rows: &[Value],
+    initial_matching_ids: &[u32],
+    tail_complete: bool,
+    tail_rows: &[Value],
+    tail_matching_ids: &[u32],
+    target_window_id: u32,
+) -> bool {
+    initial_complete
+        && tail_complete
+        && initial_rows == tail_rows
+        && initial_matching_ids == tail_matching_ids
+        && exact_unique_document_match(initial_complete, initial_matching_ids, target_window_id)
+        && exact_unique_document_match(tail_complete, tail_matching_ids, target_window_id)
+}
