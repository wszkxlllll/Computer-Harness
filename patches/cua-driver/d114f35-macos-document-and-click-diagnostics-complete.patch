+pub unsafe fn copy_ax_edited_checked(element: AXUIElementRef) -> CheckedAxValue<bool> {
+    use core_foundation::{base::CFGetTypeID, boolean::CFBoolean};
+
+    let attr = CFStr::new("AXEdited");
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        return match error {
+            kAXErrorNoValue => CheckedAxValue::Missing,
+            kAXErrorAttributeUnsupported => CheckedAxValue::Unsupported(error),
+            kAXErrorSuccess => CheckedAxValue::ReadError(kAXErrorFailure),
+            other => CheckedAxValue::ReadError(other),
+        };
+    }
+    let type_id = CFGetTypeID(value);
+    if type_id != CFBoolean::type_id() {
+        CFRelease(value);
+        return CheckedAxValue::WrongType(type_id);
+    }
+    let boolean = CFBoolean::wrap_under_create_rule(value as _);
+    CheckedAxValue::Value(boolean.into())
 }
 
