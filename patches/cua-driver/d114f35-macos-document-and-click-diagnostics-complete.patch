+/// Copy `AXDocument` without coercing non-document Foundation values to
+/// strings. CFURL is converted only with CFURLGetString; the resulting string
+/// is retained verbatim for a private, exact host-side URL comparison.
+///
+/// # Safety
+/// `element` must remain a valid AX element for the duration of the call.
+pub unsafe fn copy_ax_document_checked(element: AXUIElementRef) -> CheckedAxValue<AXDocumentValue> {
+    use core_foundation::base::CFGetTypeID;
+
+    let attr = CFStr::new("AXDocument");
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        return match error {
+            kAXErrorNoValue => CheckedAxValue::Missing,
+            kAXErrorAttributeUnsupported => CheckedAxValue::Unsupported(error),
+            kAXErrorSuccess => CheckedAxValue::ReadError(kAXErrorFailure),
+            other => CheckedAxValue::ReadError(other),
+        };
+    }
+
+    let type_id = CFGetTypeID(value);
+    if type_id == CFStr::type_id() {
+        let text = CFStr::wrap_under_create_rule(value as _).to_string();
+        return CheckedAxValue::Value(AXDocumentValue::CFString(text));
+    }
+    if type_id == CFURLGetTypeID() {
+        let text = CFURLGetString(value as _);
+        if text.is_null() {
+            CFRelease(value);
+            return CheckedAxValue::ReadError(kAXErrorFailure);
+        }
+        let text = CFStr::wrap_under_get_rule(text).to_string();
+        CFRelease(value);
+        return CheckedAxValue::Value(AXDocumentValue::CFUrl(text));
+    }
+
+    CFRelease(value);
+    CheckedAxValue::WrongType(type_id)
+}
