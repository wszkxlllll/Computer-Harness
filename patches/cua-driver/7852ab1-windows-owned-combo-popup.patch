+//! Exact, non-activating native combo-list evidence for desktop pointer input.
+//! No class-name, same-PID, bounding-union or generic owner-window admission.
+use anyhow::{bail, Result};
+use windows::Win32::Foundation::{BOOL, HWND, POINT, RECT};
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetAncestor, GetForegroundWindow, GetWindowLongPtrW, GetWindowRect,
+    GetWindowThreadProcessId, IsChild, IsIconic, IsWindow, IsWindowVisible,
+    WindowFromPoint, GA_PARENT, GA_ROOT, GWL_STYLE, WS_DISABLED,
+};
+
+// user32's exact native association and GUI-thread state. These fixed ABI
+// structures avoid a separate desktop inventory or a second input primitive.
+#[repr(C)]
+struct ComboInfo {
+    size: u32,
+    item: RECT,
+    button: RECT,
+    button_state: u32,
+    combo: HWND,
+    edit: HWND,
+    list: HWND,
+}
+#[repr(C)]
+struct GuiInfo {
+    size: u32,
+    flags: u32,
+    active: HWND,
+    focus: HWND,
+    capture: HWND,
+    menu_owner: HWND,
+    move_size: HWND,
+    caret: HWND,
+    caret_rect: RECT,
+}
+#[link(name = "user32")]
+extern "system" {
+    #[link_name = "GetComboBoxInfo"]
+    fn get_combo_box_info(window: HWND, info: *mut ComboInfo) -> BOOL;
+    #[link_name = "GetGUIThreadInfo"]
+    fn get_gui_thread_info(thread: u32, info: *mut GuiInfo) -> BOOL;
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct NativeIdentity {
+    hwnd: u64,
+    pid: u32,
+    thread: u32,
+    bounds: [i32; 4],
+}
+
+fn identity(window: HWND) -> Option<NativeIdentity> {
+    unsafe {
+        if !IsWindow(window).as_bool() || !IsWindowVisible(window).as_bool()
+            || IsIconic(window).as_bool()
+            || GetWindowLongPtrW(window, GWL_STYLE) as u32 & WS_DISABLED.0 != 0
+        { return None; }
+        let mut pid = 0;
+        let thread = GetWindowThreadProcessId(window, Some(&mut pid));
+        let mut rect = RECT::default();
+        GetWindowRect(window, &mut rect).ok()?;
+        if pid == 0 || thread == 0 || rect.right <= rect.left || rect.bottom <= rect.top {
+            return None;
+        }
+        Some(NativeIdentity { hwnd: window.0 as u64, pid, thread,
+            bounds: [rect.left, rect.top, rect.right, rect.bottom] })
+    }
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct NativeComboPopup {
+    foreground: NativeIdentity,
+    focus: NativeIdentity,
+    control: NativeIdentity,
+    list: NativeIdentity,
+}
+
+impl NativeComboPopup {
+    pub(crate) fn foreground_window(self) -> u64 { self.foreground.hwnd }
+
+    pub(crate) fn ensure_current(self, x: i32, y: i32) -> Result<()> {
+        if capture_native_combo_popup(self.list.hwnd, x, y) != Some(self) {
+            bail!("foreground_unavailable: exact native combo popup, point hit or foreground changed; no mouse input was sent");
+        }
+        Ok(())
+    }
+}
+
+/// The exact foreground GUI thread must hold capture on the hit list, and
+/// GetComboBoxInfo on its focused control/parent must name that very HWND.
+/// Cross-process controls/lists use the same native relationship proof.
+/// No global enumeration, heap allocation, activation, or input occurs here.
+pub(crate) fn capture_native_combo_popup(hit_root: u64, x: i32, y: i32) -> Option<NativeComboPopup> {
+    unsafe {
+        let foreground_window = GetForegroundWindow();
+        if hit_root == foreground_window.0 as u64 { return None; }
+        let foreground = identity(foreground_window)?;
+        let mut gui: GuiInfo = std::mem::zeroed();
+        gui.size = std::mem::size_of::<GuiInfo>() as u32;
+        if !get_gui_thread_info(foreground.thread, &mut gui).as_bool()
+            || gui.active != foreground_window || gui.capture.0 as u64 != hit_root
+        { return None; }
+        let list_window = HWND(hit_root as *mut _);
+        let list = identity(list_window)?;
+        let focus = identity(gui.focus)?;
+        let hit = WindowFromPoint(POINT { x, y });
+        if hit.0.is_null() || GetAncestor(hit, GA_ROOT) != list_window
+            || x < list.bounds[0] || x >= list.bounds[2]
+            || y < list.bounds[1] || y >= list.bounds[3]
+        { return None; }
+        let mut current = gui.focus;
+        let mut control = None;
+        let mut reached_foreground = false;
+        for _ in 0..32 {
+            if current == foreground_window { reached_foreground = true; break; }
+            if current.0.is_null() || !IsChild(foreground_window, current).as_bool() { return None; }
+            let mut info: ComboInfo = std::mem::zeroed();
+            info.size = std::mem::size_of::<ComboInfo>() as u32;
+            if get_combo_box_info(current, &mut info).as_bool()
+                && info.combo == current && info.list == list_window
+            {
+                if control.is_some() { return None; }
+                control = Some(identity(current)?);
+            }
+            let parent = GetAncestor(current, GA_PARENT);
+            if parent == current { return None; }
+            current = parent;
+        }
+        if !reached_foreground || GetForegroundWindow() != foreground_window
+            || identity(foreground_window) != Some(foreground)
+            || identity(list_window) != Some(list) || identity(gui.focus) != Some(focus)
+        { return None; }
+        Some(NativeComboPopup { foreground, focus, control: control?, list })
+    }
+}
