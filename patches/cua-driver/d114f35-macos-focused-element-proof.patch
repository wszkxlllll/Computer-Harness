+#[cfg(test)]
+mod focus_proof_tests {
+    use super::build_focus_proof_payload;
+    use crate::windows::WindowBounds;
+
+    fn proof(
+        frontmost_pid: Option<i32>,
+        focused_window_id: Option<u32>,
+        owner_matches: bool,
+        enabled: Option<bool>,
+        editable: bool,
+        ancestry_verified: bool,
+        frame: Option<[f64; 4]>,
+    ) -> Option<serde_json::Value> {
+        build_focus_proof_payload(
+            42,
+            7,
+            "s12345678",
+            frontmost_pid,
+            focused_window_id,
+            owner_matches,
+            Some("AXTextField".into()),
+            Some("Address and search bar".into()),
+            frame,
+            enabled,
+            editable,
+            ancestry_verified,
+            &WindowBounds {
+                x: 100.0,
+                y: 200.0,
+                width: 800.0,
+                height: 600.0,
+            },
+        )
+    }
+
+    #[test]
+    fn emits_only_complete_exact_focus_proof_and_never_ax_value() {
+        let value = proof(
+            Some(42),
+            Some(7),
+            true,
+            Some(true),
+            true,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0]),
+        )
+        .expect("complete exact proof");
+        assert_eq!(value["version"], "macos-focused-element-v1");
+        assert_eq!(value["coordinate_space"], "macos-screen-points");
+        assert_eq!(value["snapshot_id"], "s12345678");
+        assert_eq!(value["pid"], 42);
+        assert_eq!(value["window_id"], 7);
+        assert_eq!(value["focused_element"]["focused"], true);
+        assert_eq!(value["focused_element"]["enabled"], true);
+        assert_eq!(value["focused_element"]["editable"], true);
+        assert!(value["focused_element"].get("value").is_none());
+    }
+
+    #[test]
+    fn rejects_missing_or_mismatched_focus_facts_and_out_of_window_geometry() {
+        assert!(proof(
+            None,
+            Some(7),
+            true,
+            Some(true),
+            true,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0])
+        )
+        .is_none());
+        assert!(proof(
+            Some(42),
+            None,
+            true,
+            Some(true),
+            true,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0])
+        )
+        .is_none());
+        assert!(proof(
+            Some(42),
+            Some(7),
+            false,
+            Some(true),
+            true,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0])
+        )
+        .is_none());
+        assert!(proof(
+            Some(42),
+            Some(7),
+            true,
+            None,
+            true,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0])
+        )
+        .is_none());
+        assert!(proof(
+            Some(42),
+            Some(7),
+            true,
+            Some(false),
+            true,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0])
+        )
+        .is_none());
+        assert!(proof(
+            Some(42),
+            Some(7),
+            true,
+            Some(true),
+            false,
+            true,
+            Some([120.0, 210.0, 400.0, 30.0])
+        )
+        .is_none());
+        assert!(proof(
+            Some(42),
+            Some(7),
+            true,
+            Some(true),
+            true,
+            false,
+            Some([120.0, 210.0, 400.0, 30.0])
