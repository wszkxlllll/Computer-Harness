+#[derive(Debug, Clone, PartialEq, Eq, Serialize)]
+pub(crate) struct ClassificationDiagnostic {
+    schema: &'static str,
+    snapshot_status: &'static str,
+    candidate_pid: i32,
+    candidate_cgid: u32,
+    classification: Classification,
+    decision: Decision,
+    reason: Reason,
+    ax_windows_status: &'static str,
+    exact_ax_window_count: Option<usize>,
+    root_role_status: &'static str,
+    root_subrole_status: &'static str,
+    exact_child_count: Option<usize>,
+    child_role_status: &'static str,
+    semantic_source: SemanticSource,
+    focused_window_status: &'static str,
+    focused_element_status: &'static str,
+    front_process_status: &'static str,
+    relation_status: &'static str,
+    fresh_tail_status: &'static str,
+    point_occlusion_policy: &'static str,
+}
+
+impl ClassificationDiagnostic {
+    pub(crate) fn is_sharing_control(&self) -> bool {
+        self.classification == Classification::SharingControl
+    }
+
+    pub(crate) fn is_excluded(&self) -> bool {
+        self.classification == Classification::SharingControl
+            && self.decision == Decision::ExcludedFromOrdinaryRank
+            && self.fresh_tail_status == "matched"
+    }
+}
+
+impl ClassificationDiagnostic {
+    fn unknown(pid: i32, cgid: u32, reason: Reason, snapshot_status: &'static str) -> Self {
+        Self {
+            schema: "cua.ordinary_window_classification.v1",
+            snapshot_status,
+            candidate_pid: pid,
+            candidate_cgid: cgid,
+            classification: Classification::Unknown,
+            decision: Decision::Retained,
+            reason,
+            ax_windows_status: "not_checked",
+            exact_ax_window_count: None,
+            root_role_status: "not_checked",
+            root_subrole_status: "not_checked",
+            exact_child_count: None,
+            child_role_status: "not_checked",
+            semantic_source: SemanticSource::None,
+            focused_window_status: "not_checked",
+            focused_element_status: "not_checked",
+            front_process_status: "not_checked",
+            relation_status: "not_checked",
+            fresh_tail_status: "not_checked",
+            point_occlusion_policy: "retained",
+        }
+    }
+}
