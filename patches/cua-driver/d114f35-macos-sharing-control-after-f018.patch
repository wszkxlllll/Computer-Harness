+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Relation {
+    pid: i32,
+    cgid: Checked<u32>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct RootEvidence {
+    pid: Checked<i32>,
+    cgid: Checked<u32>,
+    role: Checked<String>,
+    subrole: Checked<String>,
+    modal: Checked<bool>,
+    main: Checked<bool>,
+    focused: Checked<bool>,
+    children: Checked<usize>,
+    forbidden_content: Checked<bool>,
+    window_relation: Checked<Relation>,
+    parent_relation: Checked<Relation>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct ChildEvidence {
+    pid: Checked<i32>,
+    cgid: Checked<u32>,
+    role: Checked<String>,
+    modal: Checked<bool>,
+    main: Checked<bool>,
+    focused: Checked<bool>,
+    children: Checked<usize>,
+    forbidden_content: Checked<bool>,
+    identifier: Checked<String>,
+    title: Checked<String>,
+    description: Checked<String>,
+    window_relation: Checked<Relation>,
+    parent_relation: Checked<Relation>,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct CandidateEvidence {
+    pid: i32,
+    cgid: u32,
+    snapshot_complete: bool,
+    ax_windows_count: Checked<usize>,
+    root: RootEvidence,
+    child: ChildEvidence,
+    focused_window: Checked<u32>,
+    focused_element_window: Checked<u32>,
+    front_process_matches_target: Option<bool>,
+    focus_window_target: u32,
+    semantic_source: SemanticSource,
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+struct Classified {
+    classification: Classification,
+    reason: Reason,
+    semantic_source: SemanticSource,
+    root_role_status: &'static str,
+    root_subrole_status: &'static str,
+    exact_child_count: Option<usize>,
+    child_role_status: &'static str,
+    focused_window_status: &'static str,
+    focused_element_status: &'static str,
+    front_process_status: &'static str,
+    relation_status: &'static str,
+    ax_windows_status: &'static str,
+    ax_windows_count: Option<usize>,
+}
+
+fn result(e: &CandidateEvidence, class: Classification, reason: Reason) -> Classified {
+    Classified {
+        classification: class,
+        reason,
+        semantic_source: e.semantic_source,
+        root_role_status: e.root.role.status(),
+        root_subrole_status: e.root.subrole.status(),
+        exact_child_count: match e.root.children {
+            Checked::Value(n) => Some(n),
+            _ => None,
+        },
+        child_role_status: e.child.role.status(),
+        focused_window_status: e.focused_window.status(),
+        focused_element_status: e.focused_element_window.status(),
+        front_process_status: match e.front_process_matches_target {
+            Some(true) => "matches_target",
+            Some(false) => "different_process",
+            None => "unavailable",
+        },
+        relation_status: "checked",
+        ax_windows_status: e.ax_windows_count.status(),
+        ax_windows_count: match e.ax_windows_count {
+            Checked::Value(n) => Some(n),
+            _ => None,
+        },
+    }
+}
+
+fn read_required_false(value: &Checked<bool>) -> bool {
+    matches!(value, Checked::Value(false))
+}
+
+fn optional_false(value: &Checked<bool>) -> bool {
+    matches!(
+        value,
+        Checked::Value(false) | Checked::Missing | Checked::Unsupported
+    )
+}
+
+fn semantic_source(e: &CandidateEvidence) -> Result<SemanticSource, Reason> {
+    let id = match &e.child.identifier {
+        Checked::Value(value) if value == EXPECTED_CONTROL => Some(SemanticSource::Identifier),
+        Checked::Value(_) => return Err(Reason::SemanticMismatch),
+        Checked::Missing | Checked::Unsupported => None,
+        Checked::ReadError | Checked::WrongType | Checked::Truncated => {
+            return Err(Reason::SemanticUnavailable);
+        }
+    };
+    let title = match &e.child.title {
+        Checked::Value(value) if value == EXPECTED_CONTROL => Some(SemanticSource::Title),
+        Checked::Value(_) => return Err(Reason::SemanticMismatch),
+        Checked::Missing | Checked::Unsupported => None,
+        Checked::ReadError | Checked::WrongType | Checked::Truncated => {
+            return Err(Reason::SemanticUnavailable);
+        }
+    };
+    let description = match &e.child.description {
+        Checked::Value(value) if value == EXPECTED_CONTROL => Some(SemanticSource::Description),
+        Checked::Value(_) => return Err(Reason::SemanticMismatch),
+        Checked::Missing | Checked::Unsupported => None,
+        Checked::ReadError | Checked::WrongType | Checked::Truncated => {
+            return Err(Reason::SemanticUnavailable);
+        }
+    };
+    id.or(title)
+        .or(description)
+        .ok_or(Reason::SemanticUnavailable)
+}
+
+fn classify(e: &CandidateEvidence) -> Classified {
+    let unknown = |reason| result(e, Classification::Unknown, reason);
+    let ordinary = |reason| result(e, Classification::Ordinary, reason);
+    if !e.snapshot_complete {
+        return unknown(Reason::IncompleteSnapshot);
+    }
+    if !matches!(e.ax_windows_count, Checked::Value(1)) {
+        return unknown(match e.ax_windows_count {
+            Checked::Value(_) => Reason::AxWindowNotUnique,
+            Checked::Truncated => Reason::TooManyWindows,
+            _ => Reason::AxWindowsUnavailable,
+        });
+    }
+    if !matches!(e.root.pid, Checked::Value(pid) if pid == e.pid)
+        || !matches!(e.root.cgid, Checked::Value(cgid) if cgid == e.cgid)
+        || !matches!(e.child.pid, Checked::Value(pid) if pid == e.pid)
+        || !matches!(e.child.cgid, Checked::Value(cgid) if cgid == e.cgid)
+    {
+        return unknown(Reason::IdentityMismatch);
+    }
+    if !matches!(e.root.role, Checked::Value(ref role) if role == "AXWindow") {
+        return ordinary(Reason::RootRoleMismatch);
+    }
+    if !matches!(e.root.subrole, Checked::Unsupported) {
+        return unknown(Reason::RootSubroleUnknown);
+    }
+    if !read_required_false(&e.root.modal)
+        || !read_required_false(&e.root.main)
+        || !read_required_false(&e.root.focused)
+        || !optional_false(&e.child.modal)
+        || !optional_false(&e.child.main)
+        || !read_required_false(&e.child.focused)
+    {
+        return ordinary(Reason::ModalOrMainOrFocused);
+    }
+    if !matches!(e.root.children, Checked::Value(1)) {
+        return unknown(Reason::RootChildrenNotExact);
+    }
+    if !matches!(e.child.role, Checked::Value(ref role) if role == "AXButton") {
+        return ordinary(Reason::ChildRoleMismatch);
+    }
+    if !matches!(e.child.children, Checked::Value(0)) {
+        return unknown(Reason::ChildHasChildren);
+    }
+    if !matches!(e.root.forbidden_content, Checked::Value(false))
+        || !matches!(e.child.forbidden_content, Checked::Value(false))
+    {
+        return match (&e.root.forbidden_content, &e.child.forbidden_content) {
+            (Checked::Value(true), _) | (_, Checked::Value(true)) => {
+                ordinary(Reason::ContentAttributePresent)
+            }
+            _ => unknown(Reason::AttributeReadUnknown),
+        };
+    }
+    let semantic = match semantic_source(e) {
+        Ok(source) => source,
+        Err(reason @ Reason::SemanticMismatch) => return ordinary(reason),
+        Err(reason) => return unknown(reason),
+    };
+    if e.semantic_source != SemanticSource::None && e.semantic_source != semantic {
+        return unknown(Reason::SemanticMismatch);
+    }
+    if !relation_matches(&e.root.window_relation, e.pid, Some(e.cgid), true)
+        || !relation_matches(&e.root.parent_relation, e.pid, None, false)
+        || !relation_matches(&e.child.window_relation, e.pid, Some(e.cgid), false)
+        || !relation_matches(&e.child.parent_relation, e.pid, Some(e.cgid), false)
+    {
+        return unknown(Reason::RelationUnknown);
+    }
+    if !matches!(e.focused_window, Checked::Value(id) if id == e.focus_window_target)
+        || !matches!(e.focused_element_window, Checked::Value(id) if id == e.focus_window_target)
+        || e.focus_window_target == e.cgid
+    {
+        return unknown(Reason::FocusOrForegroundMismatch);
+    }
+    if e.front_process_matches_target != Some(true) {
+        return unknown(Reason::FocusOrForegroundUnknown);
+    }
+    let mut accepted = result(
+        e,
+        Classification::SharingControl,
+        Reason::ExactNarrowSharingControl,
+    );
+    accepted.semantic_source = semantic;
+    accepted
+}
+
+fn relation_matches(
+    value: &Checked<Relation>,
+    pid: i32,
+    cgid: Option<u32>,
+    required: bool,
+) -> bool {
+    match value {
+        Checked::Value(relation) if relation.pid == pid => match (cgid, &relation.cgid) {
+            (Some(expected), Checked::Value(actual)) => expected == *actual,
+            (None, Checked::Value(_)) => false,
+            (None, Checked::Missing | Checked::Unsupported) => true,
+            _ => false,
+        },
+        Checked::Missing | Checked::Unsupported if !required => true,
+        _ => false,
+    }
+}
+
+struct OwnedElement(AXUIElementRef);
+
+impl Drop for OwnedElement {
+    fn drop(&mut self) {
+        unsafe { CFRelease(self.0 as CFTypeRef) }
+    }
+}
+
+fn copy_value(element: AXUIElementRef, name: &str) -> Result<CFTypeRef, Checked<()>> {
+    unsafe {
+        if matches!(deadline_remaining(), Some(remaining) if remaining.is_zero()) {
+            return Err(Checked::ReadError);
+        }
+        let attr = CFString::new(name);
+        let mut value: CFTypeRef = std::ptr::null();
+        let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+        if error == kAXErrorSuccess && !value.is_null() {
+            Ok(value)
+        } else {
+            if !value.is_null() {
+                CFRelease(value);
+            }
+            Err(match error {
+                kAXErrorNoValue => Checked::Missing,
+                kAXErrorAttributeUnsupported => Checked::Unsupported,
+                _ => Checked::ReadError,
+            })
+        }
+    }
+}
+
+unsafe fn read_string(element: AXUIElementRef, name: &str) -> Checked<String> {
+    let value = match copy_value(element, name) {
+        Ok(value) => value,
+        Err(error) => return error.map(|_| String::new()),
+    };
+    if CFGetTypeID(value) != CFString::type_id() {
+        CFRelease(value);
+        return Checked::WrongType;
+    }
+    Checked::Value(CFString::wrap_under_create_rule(value as _).to_string())
+}
+
+unsafe fn read_bool(element: AXUIElementRef, name: &str) -> Checked<bool> {
+    let value = match copy_value(element, name) {
+        Ok(value) => value,
+        Err(error) => return error.map(|_| false),
+    };
+    if CFGetTypeID(value) != CFBoolean::type_id() {
+        CFRelease(value);
+        return Checked::WrongType;
+    }
+    Checked::Value(CFBoolean::wrap_under_create_rule(value as _).into())
+}
+
+unsafe fn read_pid(element: AXUIElementRef) -> Checked<i32> {
+    if matches!(deadline_remaining(), Some(remaining) if remaining.is_zero()) {
+        return Checked::ReadError;
+    }
+    let mut pid = 0_i32;
+    match AXUIElementGetPid(element, &mut pid) {
+        kAXErrorSuccess if pid > 0 => Checked::Value(pid),
+        _ => Checked::ReadError,
+    }
+}
+
+unsafe fn read_cgid(element: AXUIElementRef) -> Checked<u32> {
+    if matches!(deadline_remaining(), Some(remaining) if remaining.is_zero()) {
+        return Checked::ReadError;
+    }
+    let mut id = 0_u32;
+    match super::bindings::_AXUIElementGetWindow(element, &mut id) {
+        kAXErrorSuccess if id > 0 => Checked::Value(id),
+        _ => Checked::ReadError,
+    }
+}
+
+unsafe fn read_element(element: AXUIElementRef, name: &str) -> Checked<OwnedElement> {
+    let value = match copy_value(element, name) {
+        Ok(value) => value,
+        Err(error) => return error.map(|_| unreachable!()),
+    };
+    if CFGetTypeID(value) != AXUIElementGetTypeID() {
+        CFRelease(value);
+        return Checked::WrongType;
+    }
+    Checked::Value(OwnedElement(value as AXUIElementRef))
+}
+
+unsafe fn read_element_array(
+    element: AXUIElementRef,
+    name: &str,
+    limit: usize,
+) -> Checked<Vec<OwnedElement>> {
+    let value = match copy_value(element, name) {
+        Ok(value) => value,
+        Err(error) => return error.map(|_| Vec::new()),
+    };
+    if CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value);
+        return Checked::WrongType;
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+    if array.len() as usize > limit {
+        return Checked::Truncated;
+    }
+    let mut elements = Vec::with_capacity(array.len() as usize);
+    for index in 0..array.len() {
+        let Some(item) = array.get(index) else {
+            return Checked::ReadError;
+        };
+        let item = *item;
+        if item.is_null() || CFGetTypeID(item) != AXUIElementGetTypeID() {
+            return Checked::WrongType;
+        }
+        core_foundation::base::CFRetain(item);
+        elements.push(OwnedElement(item as AXUIElementRef));
+    }
+    Checked::Value(elements)
+}
+
+unsafe fn read_presence(element: AXUIElementRef, name: &str) -> Checked<bool> {
+    match copy_value(element, name) {
+        Ok(value) => {
+            CFRelease(value);
+            Checked::Value(true)
+        }
+        Err(Checked::Missing) => Checked::Value(false),
+        Err(Checked::Unsupported) => Checked::Value(false),
+        Err(_) => Checked::ReadError,
+    }
+}
+
+unsafe fn forbidden_content_present(
+    element: AXUIElementRef,
+    allowed_visible_child: Option<AXUIElementRef>,
+) -> Checked<bool> {
+    for attr in ["AXVisibleChildren", "AXContents", "AXSheets"] {
+        match copy_value(element, attr) {
+            Err(Checked::Missing | Checked::Unsupported) => {}
+            Err(_) => return Checked::ReadError,
+            Ok(value) => {
+                if CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+                    CFRelease(value);
+                    return Checked::WrongType;
+                }
+                let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+                if array.len() > 2 {
+                    return Checked::Truncated;
+                }
+                if attr == "AXVisibleChildren" && array.len() > 1 {
+                    return Checked::Value(true);
+                }
+                for item in array.iter() {
+                    let item = *item;
+                    if item.is_null() || CFGetTypeID(item) != AXUIElementGetTypeID() {
+                        return Checked::WrongType;
+                    }
+                    let allowed = attr == "AXVisibleChildren"
+                        && allowed_visible_child.is_some_and(|child| {
+                            core_foundation::base::CFEqual(item, child as CFTypeRef) != 0
+                        });
+                    if !allowed {
+                        return Checked::Value(true);
+                    }
+                }
+            }
+        }
+    }
+    const CONTENT_ATTRS: [&str; 5] = [
+        "AXValue",
+        "AXText",
+        "AXSelectedText",
+        "AXSelectedTextRange",
+        "AXPlaceholderValue",
+    ];
+    for attr in CONTENT_ATTRS {
+        match read_presence(element, attr) {
+            Checked::Value(true) => return Checked::Value(true),
+            Checked::Value(false) => {}
+            _ => return Checked::ReadError,
+        }
+    }
+    Checked::Value(false)
+}
+
+unsafe fn read_relation(element: AXUIElementRef, name: &str) -> Checked<Relation> {
+    match read_element(element, name) {
+        Checked::Value(relation) => {
+            if !set_short_timeout(relation.0) {
+                return Checked::ReadError;
+            }
+            let pid = read_pid(relation.0);
+            let cgid = read_cgid(relation.0);
+            match (pid, cgid) {
+                (Checked::Value(pid), cgid) => Checked::Value(Relation { pid, cgid }),
+                _ => Checked::ReadError,
+            }
+        }
+        Checked::Missing => Checked::Missing,
+        Checked::Unsupported => Checked::Unsupported,
+        Checked::ReadError => Checked::ReadError,
+        Checked::WrongType => Checked::WrongType,
+        Checked::Truncated => Checked::Truncated,
+    }
+}
+
+unsafe fn set_short_timeout(element: AXUIElementRef) -> bool {
+    let remaining = deadline_remaining().unwrap_or(std::time::Duration::from_secs(1));
+    let seconds = remaining
+        .min(std::time::Duration::from_secs_f32(
+            AX_MESSAGE_TIMEOUT_SECONDS,
+        ))
+        .as_secs_f32();
+    timeout_setup_succeeded(
+        seconds,
+        if seconds > 0.0 {
+            AXUIElementSetMessagingTimeout(element, seconds)
+        } else {
+            -1
+        },
+    )
+}
+
+fn timeout_setup_succeeded(seconds: f32, status: i32) -> bool {
+    seconds > 0.0 && status == kAXErrorSuccess
+}
+
+#[derive(Debug, Clone, PartialEq)]
+struct WindowIdentity {
+    pid: i32,
+    cgid: u32,
+    layer: i32,
+    z: usize,
+    on_screen: bool,
+    bounds: [u64; 4],
+}
+
+impl WindowIdentity {
+    fn of(row: &crate::windows::WindowInfo) -> Self {
+        Self {
+            pid: row.pid,
+            cgid: row.window_id,
+            layer: row.layer,
+            z: row.z_index,
+            on_screen: row.is_on_screen,
+            bounds: [
+                row.bounds.x,
+                row.bounds.y,
+                row.bounds.width,
+                row.bounds.height,
+            ]
+            .map(f64::to_bits),
+        }
+    }
+}
+
+fn snapshot_is_complete(snapshot: &crate::windows::WindowEnumeration) -> bool {
+    snapshot.read_status == "ok"
+        && snapshot.raw_row_count.is_some()
+        && snapshot.malformed_row_count == 0
+}
+
+pub(crate) fn is_complete_snapshot(snapshot: &crate::windows::WindowEnumeration) -> bool {
+    snapshot_is_complete(snapshot)
+}
+
+fn same_snapshot_rows(
+    left: &crate::windows::WindowEnumeration,
+    right: &crate::windows::WindowEnumeration,
+) -> bool {
+    snapshot_is_complete(left)
+        && snapshot_is_complete(right)
+        && left.raw_row_count == right.raw_row_count
+        && left
+            .windows
+            .iter()
+            .map(WindowIdentity::of)
+            .collect::<Vec<_>>()
+            == right
+                .windows
+                .iter()
+                .map(WindowIdentity::of)
+                .collect::<Vec<_>>()
+}
+
+fn diagnostic_from_evidence(
+    e: &CandidateEvidence,
+    classified: Classified,
+    fresh_tail_status: &'static str,
+) -> ClassificationDiagnostic {
+    let excluded = classified.classification == Classification::SharingControl;
+    ClassificationDiagnostic {
+        schema: "cua.ordinary_window_classification.v1",
+        snapshot_status: if e.snapshot_complete {
+            "complete"
+        } else {
+            "incomplete"
+        },
+        candidate_pid: e.pid,
+        candidate_cgid: e.cgid,
+        classification: classified.classification,
+        decision: if excluded {
+            Decision::ExcludedFromOrdinaryRank
+        } else {
+            Decision::Retained
+        },
+        reason: classified.reason,
+        ax_windows_status: classified.ax_windows_status,
+        exact_ax_window_count: classified.ax_windows_count,
+        root_role_status: classified.root_role_status,
+        root_subrole_status: classified.root_subrole_status,
+        exact_child_count: classified.exact_child_count,
+        child_role_status: classified.child_role_status,
+        semantic_source: classified.semantic_source,
+        focused_window_status: classified.focused_window_status,
+        focused_element_status: classified.focused_element_status,
+        front_process_status: classified.front_process_status,
+        relation_status: classified.relation_status,
+        fresh_tail_status,
+        point_occlusion_policy: "retained",
+    }
+}
+
+fn early_unknown(
+    pid: i32,
+    cgid: u32,
+    reason: Reason,
+    snapshot_complete: bool,
+    ax_windows_status: &'static str,
+    count: Option<usize>,
+) -> ClassificationDiagnostic {
+    let mut value = ClassificationDiagnostic::unknown(
+        pid,
+        cgid,
+        reason,
+        if snapshot_complete {
+            "complete"
+        } else {
+            "incomplete"
+        },
+    );
+    value.ax_windows_status = ax_windows_status;
+    value.exact_ax_window_count = count;
+    value
+}
+
+unsafe fn candidate_evidence(
+    pid: i32,
+    cgid: u32,
+    focus_window_target: u32,
+    snapshot_complete: bool,
+) -> Result<CandidateEvidence, ClassificationDiagnostic> {
+    let app = AXUIElementCreateApplication(pid);
+    if app.is_null() {
+        return Err(early_unknown(
+            pid,
+            cgid,
+            Reason::AxWindowsUnavailable,
+            snapshot_complete,
+            "read_error",
+            None,
+        ));
+    }
+    let app = OwnedElement(app);
+    if !set_short_timeout(app.0) {
+        return Err(early_unknown(
+            pid,
+            cgid,
+            Reason::AttributeReadUnknown,
+            snapshot_complete,
+            "timeout_setup_failed",
+            None,
+        ));
+    }
+    let mut windows = match read_element_array(app.0, "AXWindows", MAX_WINDOWS) {
+        Checked::Value(windows) => windows,
+        Checked::Truncated => {
+            return Err(early_unknown(
+                pid,
+                cgid,
+                Reason::TooManyWindows,
+                snapshot_complete,
+                "truncated",
+                None,
+            ));
+        }
+        other => {
+            return Err(early_unknown(
+                pid,
+                cgid,
+                Reason::AxWindowsUnavailable,
+                snapshot_complete,
+                other.status(),
+                None,
+            ));
+        }
+    };
+    let window_count = windows.len();
+    let mut matches = Vec::new();
+    let mut identity_unknown = false;
+    for (index, element) in windows.iter().enumerate() {
+        if !set_short_timeout(element.0) {
+            identity_unknown = true;
+            continue;
+        }
+        match read_cgid(element.0) {
+            Checked::Value(id) if id == cgid => matches.push(index),
+            Checked::Value(_) => {}
+            _ => identity_unknown = true,
+        }
+    }
+    if identity_unknown {
+        return Err(early_unknown(
+            pid,
+            cgid,
+            Reason::IdentityMismatch,
+            snapshot_complete,
+            "identity_unknown",
+            Some(window_count),
+        ));
+    }
+    if matches.len() != 1 {
+        return Err(early_unknown(
+            pid,
+            cgid,
+            Reason::AxWindowNotUnique,
+            snapshot_complete,
+            "value",
+            Some(matches.len()),
+        ));
+    }
+    let root = windows.swap_remove(matches[0]);
+    if !set_short_timeout(root.0) {
+        return Err(early_unknown(
+            pid,
+            cgid,
+            Reason::AttributeReadUnknown,
+            snapshot_complete,
+            "timeout_setup_failed",
+            Some(window_count),
+        ));
+    }
+
+    let root_children = read_element_array(root.0, "AXChildren", MAX_NODES);
+    let (root_child_count, child) = match root_children {
+        Checked::Value(mut children) => {
+            let count = children.len();
+            let child = (count == 1).then(|| children.remove(0));
+            (Checked::Value(count), child)
+        }
+        Checked::Truncated => (Checked::Truncated, None),
+        Checked::Missing => (Checked::Missing, None),
+        Checked::Unsupported => (Checked::Unsupported, None),
+        Checked::ReadError => (Checked::ReadError, None),
+        Checked::WrongType => (Checked::WrongType, None),
+    };
+    let default_child = ChildEvidence {
+        pid: Checked::ReadError,
+        cgid: Checked::ReadError,
+        role: Checked::ReadError,
+        modal: Checked::ReadError,
+        main: Checked::ReadError,
+        focused: Checked::ReadError,
+        children: Checked::ReadError,
+        forbidden_content: Checked::ReadError,
+        identifier: Checked::ReadError,
+        title: Checked::ReadError,
+        description: Checked::ReadError,
+        window_relation: Checked::ReadError,
+        parent_relation: Checked::ReadError,
+    };
+    let child_element_for_root = child.as_ref().map(|element| element.0);
+    let child_evidence = if let Some(child) = child.as_ref() {
+        if !set_short_timeout(child.0) {
+            default_child
+        } else {
+            let child_children = read_element_array(child.0, "AXChildren", 1);
+            // Mapping consumes and drops copied descendants immediately.
+            let child_count = child_children.map(|children| children.len());
+            ChildEvidence {
+                pid: read_pid(child.0),
+                cgid: read_cgid(child.0),
+                role: read_string(child.0, "AXRole"),
+                modal: read_bool(child.0, "AXModal"),
+                main: read_bool(child.0, "AXMain"),
+                focused: read_bool(child.0, "AXFocused"),
+                children: child_count,
+                forbidden_content: forbidden_content_present(child.0, None),
+                identifier: read_string(child.0, "AXIdentifier"),
+                title: read_string(child.0, "AXTitle"),
+                description: read_string(child.0, "AXDescription"),
+                window_relation: read_relation(child.0, "AXWindow"),
+                parent_relation: read_relation(child.0, "AXParent"),
+            }
+        }
+    } else {
+        default_child
+    };
+
+    let focused_window = match read_element(app.0, "AXFocusedWindow") {
+        Checked::Value(element) => {
+            if set_short_timeout(element.0) {
+                read_cgid(element.0)
+            } else {
+                Checked::ReadError
+            }
+        }
+        Checked::Missing => Checked::Missing,
+        Checked::Unsupported => Checked::Unsupported,
+        Checked::ReadError => Checked::ReadError,
+        Checked::WrongType => Checked::WrongType,
+        Checked::Truncated => Checked::Truncated,
+    };
+    let focused_element = match read_element(app.0, "AXFocusedUIElement") {
+        Checked::Value(element) => {
+            let element_pid = if set_short_timeout(element.0) {
+                read_pid(element.0)
+            } else {
+                Checked::ReadError
+            };
+            if !matches!(element_pid, Checked::Value(value) if value == pid) {
+                Checked::ReadError
+            } else {
+                match read_relation(element.0, "AXWindow") {
+                    Checked::Value(relation) => match relation.cgid {
+                        Checked::Value(id) => Checked::Value(id),
+                        other => other,
+                    },
+                    Checked::Missing | Checked::Unsupported => read_cgid(element.0),
+                    Checked::ReadError => Checked::ReadError,
+                    Checked::WrongType => Checked::WrongType,
+                    Checked::Truncated => Checked::Truncated,
+                }
+            }
+        }
+        Checked::Missing => Checked::Missing,
+        Checked::Unsupported => Checked::Unsupported,
+        Checked::ReadError => Checked::ReadError,
+        Checked::WrongType => Checked::WrongType,
+        Checked::Truncated => Checked::Truncated,
+    };
+    let front_process_matches_target =
+        crate::input::skylight::front_process_matches(pid, focus_window_target);
+
+    Ok(CandidateEvidence {
+        pid,
+        cgid,
+        snapshot_complete,
+        ax_windows_count: Checked::Value(1),
+        root: RootEvidence {
+            pid: read_pid(root.0),
+            cgid: read_cgid(root.0),
+            role: read_string(root.0, "AXRole"),
+            subrole: read_string(root.0, "AXSubrole"),
+            modal: read_bool(root.0, "AXModal"),
+            main: read_bool(root.0, "AXMain"),
+            focused: read_bool(root.0, "AXFocused"),
+            children: root_child_count,
+            forbidden_content: forbidden_content_present(root.0, child_element_for_root),
+            window_relation: read_relation(root.0, "AXWindow"),
+            parent_relation: read_relation(root.0, "AXParent"),
+        },
+        child: child_evidence,
+        focused_window,
+        focused_element_window: focused_element,
+        front_process_matches_target,
+        focus_window_target,
+        semantic_source: SemanticSource::None,
+    })
+}
+
+pub(crate) fn inspect_candidate(
+    pid: i32,
+    cgid: u32,
+    focus_window_target: u32,
+    snapshot_complete: bool,
+    deadline: Instant,
+) -> ClassificationDiagnostic {
+    if Instant::now() >= deadline {
+        return early_unknown(
+            pid,
+            cgid,
+            Reason::DeadlineExceeded,
+            snapshot_complete,
+            "deadline",
+            None,
+        );
+    }
+    let evidence = use_deadline(deadline, || unsafe {
+        candidate_evidence(pid, cgid, focus_window_target, snapshot_complete)
+    });
+    match evidence {
+        Ok(mut evidence) => {
+            if Instant::now() >= deadline {
+                return early_unknown(
+                    pid,
+                    cgid,
+                    Reason::DeadlineExceeded,
+                    snapshot_complete,
+                    "deadline",
+                    None,
+                );
+            }
+            evidence.semantic_source = match semantic_source(&evidence) {
+                Ok(source) => source,
+                Err(_) => SemanticSource::None,
+            };
+            let classified = classify(&evidence);
+            diagnostic_from_evidence(&evidence, classified, "not_yet_reconciled")
+        }
+        Err(value) => value,
+    }
+}
+
+pub(crate) fn confirm_fresh_candidate(
+    prior: &ClassificationDiagnostic,
+    rechecked: &ClassificationDiagnostic,
+    pid: i32,
+    cgid: u32,
+    focus_window_target: u32,
+    before: &crate::windows::WindowEnumeration,
+    after: &crate::windows::WindowEnumeration,
+    after_focus_matches: Option<bool>,
+    after_focused_window: Option<u32>,
+    deadline: Instant,
+) -> ClassificationDiagnostic {
+    if Instant::now() >= deadline {
+        let mut value = ClassificationDiagnostic::unknown(
+            pid,
+            cgid,
+            Reason::DeadlineExceeded,
+            if snapshot_is_complete(after) {
+                "complete"
+            } else {
+                "incomplete"
+            },
+        );
+        value.fresh_tail_status = "deadline";
+        return value;
+    }
+    if prior.classification != Classification::SharingControl
+        || rechecked.classification != Classification::SharingControl
+        || !same_snapshot_rows(before, after)
+        || after_focus_matches != Some(true)
+        || after_focused_window != Some(focus_window_target)
+    {
+        let mut value = ClassificationDiagnostic::unknown(
+            pid,
+            cgid,
+            Reason::FreshTailMismatch,
+            if snapshot_is_complete(after) {
+                "complete"
+            } else {
+                "incomplete"
+            },
+        );
+        value.fresh_tail_status = "mismatch";
+        value.front_process_status = if after_focus_matches == Some(false) {
+            "different_process"
+        } else {
+            "unavailable_or_unverified"
+        };
+        value.focused_window_status = if after_focused_window == Some(focus_window_target) {
+            "matches_target"
+        } else {
+            "different_or_unknown"
+        };
+        return value;
+    }
+    let mut value = rechecked.clone();
+    value.fresh_tail_status = "matched";
+    value
+}
+
+pub(crate) fn retain_unconfirmed(
+    prior: &ClassificationDiagnostic,
+    deadline_expired: bool,
+) -> ClassificationDiagnostic {
+    let mut value = prior.clone();
+    value.classification = Classification::Unknown;
+    value.decision = Decision::Retained;
+    value.reason = if deadline_expired {
+        Reason::DeadlineExceeded
+    } else {
+        Reason::FreshTailMismatch
+    };
+    value.fresh_tail_status = if deadline_expired {
+        "deadline"
+    } else {
+        "unverified"
+    };
+    value
+}
+
+pub(crate) fn sharing_candidate_ids(
+    snapshot: &crate::windows::WindowEnumeration,
+    target_pid: i32,
+    target_cgid: u32,
+) -> Vec<u32> {
+    if !snapshot_is_complete(snapshot) {
+        return Vec::new();
+    }
+    let Some(target) = snapshot
+        .windows
+        .iter()
+        .find(|row| row.pid == target_pid && row.window_id == target_cgid && row.layer == 0)
+    else {
+        return Vec::new();
+    };
+    snapshot
+        .windows
+        .iter()
+        .filter(|row| {
+            row.pid == target_pid
+                && row.layer == 0
+                && row.is_on_screen
+                && row.window_id != target_cgid
+                && row.z_index > target.z_index
+        })
+        .map(|row| row.window_id)
+        .take(MAX_WINDOWS)
+        .collect()
+}
