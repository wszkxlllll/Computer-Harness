+        let rechecked = diagnostic_from_evidence(&evidence, classified, "not_yet_reconciled");
+        let before = snapshot(vec![row(7, 0), row(88, 1)], 0);
+        let after = snapshot(vec![row(7, 0), row(88, 2)], 0);
+        let final_value = confirm_fresh_candidate(
