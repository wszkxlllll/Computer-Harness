+//! Fail-closed classification for the system Window Sharing capture control.
+//!
+//! Only a complete, narrow AX tree can remove a same-process layer-0 control
+//! from ordinary-window z-order. Point hit testing and the all-layer occlusion
+//! snapshot deliberately do not call this module.
+
+#![allow(non_upper_case_globals)]
+
+use super::bindings::{
+    kAXErrorAttributeUnsupported, kAXErrorNoValue, kAXErrorSuccess, AXUIElementCopyAttributeValue,
+    AXUIElementCreateApplication, AXUIElementGetPid, AXUIElementGetTypeID, AXUIElementRef,
+    AXUIElementSetMessagingTimeout,
+};
+use core_foundation::{
+    array::CFArray,
+    base::{CFGetTypeID, CFRelease, CFTypeRef, TCFType},
+    boolean::CFBoolean,
+    string::CFString,
+};
+use serde::Serialize;
+use std::{cell::RefCell, time::Instant};
+
+const MAX_WINDOWS: usize = 32;
+const MAX_NODES: usize = 2;
+const AX_MESSAGE_TIMEOUT_SECONDS: f32 = 0.025;
+const EXPECTED_CONTROL: &str = "WindowSharingSessionButton";
+
+thread_local! {
+    static AX_DEADLINE: RefCell<Option<Instant>> = const { RefCell::new(None) };
+}
+
+struct DeadlineScope(Option<Instant>);
+
+impl Drop for DeadlineScope {
+    fn drop(&mut self) {
+        AX_DEADLINE.with(|deadline| *deadline.borrow_mut() = self.0);
+    }
+}
+
+fn use_deadline<T>(deadline: Instant, f: impl FnOnce() -> T) -> T {
+    let old = AX_DEADLINE.with(|cell| cell.replace(Some(deadline)));
+    let _scope = DeadlineScope(old);
+    f()
+}
+
+fn deadline_remaining() -> Option<std::time::Duration> {
+    AX_DEADLINE.with(|cell| {
+        cell.borrow()
+            .as_ref()
+            .map(|deadline| deadline.saturating_duration_since(Instant::now()))
+    })
+}
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+enum Checked<T> {
+    Value(T),
+    Missing,
+    Unsupported,
+    ReadError,
+    WrongType,
+    Truncated,
+}
+
+impl<T> Checked<T> {
+    fn status(&self) -> &'static str {
+        match self {
+            Self::Value(_) => "value",
+            Self::Missing => "missing",
+            Self::Unsupported => "unsupported",
+            Self::ReadError => "read_error",
+            Self::WrongType => "wrong_type",
+            Self::Truncated => "truncated",
+        }
+    }
+
+    fn map<U>(self, f: impl FnOnce(T) -> U) -> Checked<U> {
+        match self {
+            Self::Value(value) => Checked::Value(f(value)),
+            Self::Missing => Checked::Missing,
+            Self::Unsupported => Checked::Unsupported,
+            Self::ReadError => Checked::ReadError,
+            Self::WrongType => Checked::WrongType,
+            Self::Truncated => Checked::Truncated,
+        }
+    }
+}
