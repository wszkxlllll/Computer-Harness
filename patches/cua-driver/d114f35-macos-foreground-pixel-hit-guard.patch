+/// Pure point hit-test over a WindowServer snapshot ordered by `z_index`.
+/// Only an exact, driver-owned, explicitly mouse-ignoring overlay is skipped.
+pub(crate) fn exact_window_is_top_at_point_in(
+    windows: &[WindowInfo],
+    target_pid: i32,
+    target_window_id: u32,
+    x: f64,
+    y: f64,
+    owned_mouse_ignoring_overlay: Option<(i32, u32)>,
+) -> bool {
+    if !x.is_finite() || !y.is_finite() {
+        return false;
+    }
+
+    let Some(target) = windows
+        .iter()
+        .find(|window| window.pid == target_pid && window.window_id == target_window_id)
+    else {
+        return false;
+    };
+    if !target.is_on_screen
+        || !bounds_are_usable(&target.bounds)
+        || !bounds_contain(&target.bounds, x, y)
+    {
+        return false;
+    }
+
+    for window in windows.iter().filter(|window| window.is_on_screen) {
+        if owned_mouse_ignoring_overlay.is_some_and(|(overlay_pid, overlay_id)| {
+            window.pid == overlay_pid && window.window_id == overlay_id
+        }) {
+            continue;
+        }
+        if window.window_id == target_window_id && window.pid == target_pid {
+            continue;
+        }
+        if window.z_index < target.z_index {
+            continue;
+        }
+        if !bounds_are_usable(&window.bounds) {
+            // A potentially-above on-screen row with unreadable geometry could
+            // cover the click point; do not infer it is absent.
+            return false;
+        }
+        if bounds_contain(&window.bounds, x, y) {
+            return false;
+        }
+    }
+
+    true
+}
+
+fn bounds_are_usable(bounds: &WindowBounds) -> bool {
+    bounds.x.is_finite()
+        && bounds.y.is_finite()
+        && bounds.width.is_finite()
+        && bounds.height.is_finite()
+        && bounds.width > 0.0
+        && bounds.height > 0.0
+}
+
+fn bounds_contain(bounds: &WindowBounds, x: f64, y: f64) -> bool {
+    x >= bounds.x && y >= bounds.y && x < bounds.x + bounds.width && y < bounds.y + bounds.height
+}
+
+/// Require the exact target to be the top WindowServer window at the point.
+/// Empty/failed enumeration is fail-closed.
+pub(crate) fn exact_window_is_top_at_point(
+    target_pid: i32,
+    target_window_id: u32,
+    x: f64,
+    y: f64,
+    owned_mouse_ignoring_overlay: Option<(i32, u32)>,
+) -> bool {
+    exact_window_is_top_at_point_in(
+        &all_windows_any_layer(),
+        target_pid,
+        target_window_id,
+        x,
+        y,
+        owned_mouse_ignoring_overlay,
+    )
+}
