+#[derive(Debug, Clone)]
+struct AttachedSheetChildFacts {
+    pid: i32,
+    window_id: u32,
+    owner_pid: i32,
+    ax_parent_pid: i32,
+    ax_parent_window_id: u32,
+    ax_parent_verified: bool,
+    visible: bool,
+    bounds: crate::windows::WindowBounds,
+    ax_frame: [f64; 4],
+}
+
+#[derive(Debug, Clone)]
+struct AttachedSheetProofFacts {
+    snapshot_id: String,
+    pid: i32,
+    parent_window_id: u32,
+    parent_ax_matches: usize,
+    parent_role: Option<String>,
+    parent_owner_pid: i32,
+    parent_bounds: crate::windows::WindowBounds,
+    parent_ax_frame: [f64; 4],
+    direct_children_status: &'static str,
+    direct_child_count: usize,
+    direct_child_roles: Vec<Option<String>>,
+    sheets: Vec<AttachedSheetChildFacts>,
+    frontmost_pid: Option<i32>,
+    focused_window_id: Option<u32>,
+    parent_tail_revalidated: bool,
+    children_tail_revalidated: bool,
+    focus_tail_revalidated: bool,
+    child_tail_revalidated: bool,
+}
+
+fn build_attached_sheet_proof_payload(facts: &AttachedSheetProofFacts) -> Option<Value> {
+    if facts.snapshot_id.trim().is_empty()
+        || facts.pid <= 0
+        || facts.parent_window_id == 0
+        || facts.parent_ax_matches != 1
+        || facts.parent_role.as_deref() != Some("AXWindow")
+        || facts
+            .sheets
+            .iter()
+            .any(|sheet| sheet.window_id == 0 || sheet.window_id == facts.parent_window_id)
+        || facts.parent_owner_pid != facts.pid
+        || !valid_positive_rect(
+            facts.parent_bounds.x,
+            facts.parent_bounds.y,
+            facts.parent_bounds.width,
+            facts.parent_bounds.height,
+        )
+        || facts.direct_children_status != "success"
+        || facts.direct_child_count != facts.direct_child_roles.len()
+        || facts.direct_child_roles.iter().any(Option::is_none)
+        || facts.frontmost_pid != Some(facts.pid)
+        || !facts.parent_tail_revalidated
+        || !facts.children_tail_revalidated
+        || !facts.focus_tail_revalidated
+        || facts
+            .direct_child_roles
+            .iter()
+            .flatten()
+            .filter(|role| role.as_str() == "AXSheet")
+            .count()
+            != facts.sheets.len()
+    {
+        return None;
+    }
+    let [parent_x, parent_y, parent_width, parent_height] = facts.parent_ax_frame;
+    if !valid_positive_rect(parent_x, parent_y, parent_width, parent_height)
+        || parent_x != facts.parent_bounds.x
+        || parent_y != facts.parent_bounds.y
+        || parent_width != facts.parent_bounds.width
+        || parent_height != facts.parent_bounds.height
+    {
+        return None;
+    }
+    let (status, sheet_json) = match facts.sheets.as_slice() {
+        [] if facts.focused_window_id == Some(facts.parent_window_id) => ("none", None),
+        [sheet]
+            if facts.focused_window_id == Some(sheet.window_id)
+                && sheet.pid == facts.pid
+                && sheet.owner_pid == facts.pid
+                && sheet.ax_parent_pid == facts.pid
+                && sheet.ax_parent_window_id == facts.parent_window_id
+                && sheet.ax_parent_verified
+                && sheet.visible
+                && facts.child_tail_revalidated =>
+        {
+            let [x, y, width, height] = sheet.ax_frame;
+            if !valid_positive_rect(x, y, width, height)
+                || x != sheet.bounds.x
+                || y != sheet.bounds.y
+                || width != sheet.bounds.width
+                || height != sheet.bounds.height
+            {
+                return None;
+            }
+            (
+                "sheet",
+                Some(serde_json::json!({
+                    "role": "AXSheet",
+                    "pid": sheet.pid,
+                    "window_id": sheet.window_id,
+                    "owner_pid": sheet.owner_pid,
+                    "ax_parent_pid": sheet.ax_parent_pid,
+                    "ax_parent_window_id": sheet.ax_parent_window_id,
+                    "ax_parent_verified": true,
+                    "bounds": { "x": sheet.bounds.x, "y": sheet.bounds.y, "width": sheet.bounds.width, "height": sheet.bounds.height }
+                })),
+            )
+        }
+        _ => return None,
+    };
+    let mut proof = serde_json::json!({
+        "version": "macos-attached-sheet-v1",
+        "snapshot_id": facts.snapshot_id,
+        "pid": facts.pid,
+        "parent_window_id": facts.parent_window_id,
+        "parent_owner_pid": facts.parent_owner_pid,
+        "parent_bounds": { "x": facts.parent_bounds.x, "y": facts.parent_bounds.y, "width": facts.parent_bounds.width, "height": facts.parent_bounds.height },
+        "direct_children_status": "success",
+        "direct_child_count": facts.direct_child_count,
+        "status": status,
+        "frontmost_pid": facts.pid,
+        "focused_window_id": facts.focused_window_id,
+    });
+    if let Some(sheet) = sheet_json {
+        proof["sheet"] = sheet;
+    }
+    Some(proof)
+}
