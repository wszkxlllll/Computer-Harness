+/// Copy a required AX string attribute and preserve missing/type/read failures.
+///
+/// # Safety
+/// `element` must remain valid for the duration of the AX call.
+pub unsafe fn copy_string_attr_checked(
+    element: AXUIElementRef,
+    attr_name: &str,
+) -> Result<String, AXError> {
+    let attr = CFStr::new(attr_name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        return Err(if error == kAXErrorSuccess {
+            kAXErrorFailure
+        } else {
+            error
+        });
+    }
+    if core_foundation::base::CFGetTypeID(value) != CFStr::type_id() {
+        CFRelease(value);
+        return Err(kAXErrorFailure);
+    }
+    let string = CFStr::wrap_under_create_rule(value as _).to_string();
+    Ok(string)
+}
