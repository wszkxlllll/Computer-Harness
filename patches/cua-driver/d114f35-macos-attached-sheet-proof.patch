+/// Independently attest one exact app window's direct AXSheet relationship.
+/// AXChildren failures, unclassifiable child roles, ambiguous sheets, stale
+/// identities, or WindowServer disagreement produce no proof.
+fn attached_sheet_proof(pid: i32, window_id: u32, snapshot_id: &str) -> Option<Value> {
+    use crate::ax::bindings::{
+        copy_element_array_attr_checked, copy_element_attr, copy_string_attr_checked,
+        kAXErrorSuccess, AXUIElementCreateApplication, AXUIElementGetPid,
+    };
+    use core_foundation::base::{CFEqual, CFRelease, CFTypeRef};
+
+    if crate::apps::frontmost_pid() != Some(pid)
+        || crate::windows::resolve_window_owner(pid, window_id)
+            != crate::windows::WindowOwner::SamePid
+    {
+        return None;
+    }
+    let parent_bounds = crate::windows::window_bounds_by_id(window_id)?;
+    let parent_owner_pid = match crate::windows::resolve_window_owner(pid, window_id) {
+        crate::windows::WindowOwner::SamePid => pid,
+        _ => return None,
+    };
+
+    unsafe {
+        let app = AXUIElementCreateApplication(pid);
+        if app.is_null() {
+            return None;
+        }
+        let windows = match copy_element_array_attr_checked(app, "AXWindows") {
+            Ok(windows) => windows,
+            Err(_) => {
+                CFRelease(app as CFTypeRef);
+                return None;
+            }
+        };
+        let mut matching_parent = Vec::new();
+        let mut parent_roles_read = true;
+        for candidate in &windows {
+            if crate::ax::bindings::ax_get_window_id(*candidate) == Some(window_id) {
+                match copy_string_attr_checked(*candidate, "AXRole") {
+                    Ok(role) if role == "AXWindow" => matching_parent.push(*candidate),
+                    _ => parent_roles_read = false,
+                }
+            }
+        }
+        if !parent_roles_read || matching_parent.len() != 1 {
+            for candidate in windows {
+                CFRelease(candidate as CFTypeRef);
+            }
+            CFRelease(app as CFTypeRef);
+            return None;
+        }
+        let parent = matching_parent[0];
+        let mut parent_pid = 0;
+        let parent_pid_ok =
+            AXUIElementGetPid(parent, &mut parent_pid) == kAXErrorSuccess && parent_pid == pid;
+        let parent_ax_frame = crate::ax::bindings::element_screen_rect(parent);
+        let children = match copy_element_array_attr_checked(parent, "AXChildren") {
+            Ok(children) => children,
+            Err(_) => {
+                for candidate in windows {
+                    CFRelease(candidate as CFTypeRef);
+                }
+                CFRelease(app as CFTypeRef);
+                return None;
+            }
+        };
+        let mut roles = Vec::with_capacity(children.len());
+        let mut sheets = Vec::new();
+        let mut role_read_failed = false;
+        for child in &children {
+            let role = match copy_string_attr_checked(*child, "AXRole") {
+                Ok(role) if !role.trim().is_empty() => role,
+                Ok(_) => {
+                    role_read_failed = true;
+                    break;
+                }
+                Err(_) => {
+                    role_read_failed = true;
+                    break;
+                }
+            };
+            roles.push(Some(role.clone()));
+            if role != "AXSheet" {
+                continue;
+            }
+            let child_parent = copy_element_attr(*child, "AXParent");
+            let parent_verified = child_parent
+                .map(|value| CFEqual(value as CFTypeRef, parent as CFTypeRef) != 0)
+                .unwrap_or(false);
+            if let Some(value) = child_parent {
+                CFRelease(value as CFTypeRef);
+            }
+            let mut child_pid = 0;
+            let child_pid_ok = AXUIElementGetPid(*child, &mut child_pid) == kAXErrorSuccess;
+            let child_window_id = crate::ax::bindings::ax_get_window_id(*child);
+            let child_window_id = match child_window_id {
+                Some(value) if value != window_id => value,
+                _ => {
+                    sheets.push((
+                        *child,
+                        AttachedSheetChildFacts {
+                            pid: child_pid,
+                            window_id: child_window_id.unwrap_or(0),
+                            owner_pid: -1,
+                            ax_parent_pid: -1,
+                            ax_parent_window_id: 0,
+                            ax_parent_verified: false,
+                            visible: false,
+                            bounds: crate::windows::WindowBounds {
+                                x: f64::NAN,
+                                y: f64::NAN,
+                                width: 0.0,
+                                height: 0.0,
+                            },
+                            ax_frame: [f64::NAN, f64::NAN, 0.0, 0.0],
+                        },
+                    ));
+                    continue;
+                }
+            };
+            let child_window = crate::windows::window_info_by_id(child_window_id);
+            let child_owner_pid = match crate::windows::resolve_window_owner(pid, child_window_id) {
+                crate::windows::WindowOwner::SamePid => pid,
+                crate::windows::WindowOwner::ForeignPid { owner_pid, .. } => owner_pid,
+                crate::windows::WindowOwner::Unknown => -1,
+            };
+            let child_bounds = child_window
+                .as_ref()
+                .map(|window| window.bounds.clone())
+                .unwrap_or(crate::windows::WindowBounds {
+                    x: f64::NAN,
+                    y: f64::NAN,
+                    width: 0.0,
+                    height: 0.0,
+                });
+            let child_ax_frame = crate::ax::bindings::element_screen_rect(*child).unwrap_or([
+                f64::NAN,
+                f64::NAN,
+                0.0,
+                0.0,
+            ]);
+            let child_parent_pid = if parent_verified { pid } else { -1 };
+            sheets.push((
+                *child,
+                AttachedSheetChildFacts {
+                    pid: if child_pid_ok { child_pid } else { -1 },
+                    window_id: child_window_id,
+                    owner_pid: child_owner_pid,
+                    ax_parent_pid: child_parent_pid,
+                    ax_parent_window_id: if parent_verified { window_id } else { 0 },
+                    ax_parent_verified: parent_verified,
+                    visible: child_window
+                        .as_ref()
+                        .is_some_and(|window| window.is_on_screen),
+                    bounds: child_bounds,
+                    ax_frame: child_ax_frame,
+                },
+            ));
+        }
+        if role_read_failed || !parent_pid_ok {
+            for child in children {
+                CFRelease(child as CFTypeRef);
+            }
+            for candidate in windows {
+                CFRelease(candidate as CFTypeRef);
+            }
+            CFRelease(app as CFTypeRef);
+            return None;
+        }
+        let frontmost_before = crate::apps::frontmost_pid();
+        let focused_before = crate::ax::bindings::focused_window_id_of_pid(pid);
+        let parent_frame_ok = parent_ax_frame.is_some_and(|frame| {
+            frame[0] == parent_bounds.x
+                && frame[1] == parent_bounds.y
+                && frame[2] == parent_bounds.width
+                && frame[3] == parent_bounds.height
+        });
+        let parent_relation_ok = crate::windows::resolve_window_owner(pid, window_id)
+            == crate::windows::WindowOwner::SamePid;
+
+        // Tail-read direct children and parent/focus identity while retained
+        // AX proxies are still alive. A changed or unreadable fact is unknown.
+        let fresh_windows = copy_element_array_attr_checked(app, "AXWindows");
+        let fresh_parent_bounds = crate::windows::window_bounds_by_id(window_id);
+        let fresh_parent_frame = crate::ax::bindings::element_screen_rect(parent);
+        let parent_tail_revalidated = fresh_windows.as_ref().is_ok_and(|fresh| {
+            let matches: Vec<_> = fresh
+                .iter()
+                .filter(|candidate| {
+                    crate::ax::bindings::ax_get_window_id(**candidate) == Some(window_id)
+                })
+                .collect();
+            matches.len() == 1 && CFEqual(*matches[0] as CFTypeRef, parent as CFTypeRef) != 0
+        }) && crate::windows::resolve_window_owner(pid, window_id)
+            == crate::windows::WindowOwner::SamePid
+            && fresh_parent_bounds
+                .as_ref()
+                .is_some_and(|fresh| same_bounds(&parent_bounds, fresh))
+            && fresh_parent_frame.is_some_and(|frame| Some(frame) == parent_ax_frame);
+        if let Ok(fresh) = fresh_windows {
+            for candidate in fresh {
+                CFRelease(candidate as CFTypeRef);
+            }
+        }
+        let fresh_children = copy_element_array_attr_checked(parent, "AXChildren");
+        let children_tail_revalidated =
+            fresh_children.as_ref().is_ok_and(|fresh| {
+                if fresh.len() != children.len() {
+                    return false;
+                }
+                fresh.iter().zip(children.iter()).zip(roles.iter()).all(
+                    |((next, previous), role)| {
+                        role.as_ref().is_some_and(|expected| {
+                            copy_string_attr_checked(*next, "AXRole")
+                                .is_ok_and(|actual| actual == *expected)
+                        }) && CFEqual(*next as CFTypeRef, *previous as CFTypeRef) != 0
+                    },
+                )
+            });
+        if let Ok(fresh) = fresh_children {
+            for child in fresh {
+                CFRelease(child as CFTypeRef);
+            }
+        }
+        let child_tail_revalidated = if sheets.len() == 1 {
+            let (sheet_element, sheet) = &sheets[0];
+            let fresh_owner = crate::windows::resolve_window_owner(pid, sheet.window_id);
+            let fresh_window = crate::windows::window_info_by_id(sheet.window_id);
+            let fresh_frame = crate::ax::bindings::element_screen_rect(*sheet_element);
+            let mut fresh_pid = 0;
+            let fresh_pid_matches = AXUIElementGetPid(*sheet_element, &mut fresh_pid)
+                == kAXErrorSuccess
+                && fresh_pid == pid;
+            fresh_owner == crate::windows::WindowOwner::SamePid
+                && fresh_pid_matches
+                && fresh_window.as_ref().is_some_and(|window| {
+                    window.is_on_screen && same_bounds(&sheet.bounds, &window.bounds)
+                })
+                && fresh_frame.is_some_and(|frame| frame == sheet.ax_frame)
+                && crate::ax::bindings::ax_get_window_id(*sheet_element) == Some(sheet.window_id)
+                && copy_element_attr(*sheet_element, "AXParent").is_some_and(|fresh_parent| {
+                    let same = CFEqual(fresh_parent as CFTypeRef, parent as CFTypeRef) != 0;
+                    CFRelease(fresh_parent as CFTypeRef);
+                    same
+                })
+        } else {
+            true
+        };
+        // Keep focus as the final OS read after all parent and child tail checks.
+        let frontmost_after = crate::apps::frontmost_pid();
+        let focused_after = crate::ax::bindings::focused_window_id_of_pid(pid);
+        let focus_tail_revalidated = frontmost_before == Some(pid)
+            && frontmost_after == frontmost_before
+            && focused_after == focused_before;
+        let focused_window_id = focused_after;
+        let facts = AttachedSheetProofFacts {
+            snapshot_id: snapshot_id.to_owned(),
+            pid,
+            parent_window_id: window_id,
+            parent_ax_matches: matching_parent.len(),
+            parent_role: Some("AXWindow".to_owned()),
+            parent_owner_pid,
+            parent_bounds: parent_bounds.clone(),
+            parent_ax_frame: parent_ax_frame.unwrap_or([f64::NAN, f64::NAN, 0.0, 0.0]),
+            direct_children_status: "success",
+            direct_child_count: children.len(),
+            direct_child_roles: roles,
+            sheets: sheets.iter().map(|(_, facts)| facts.clone()).collect(),
+            frontmost_pid: frontmost_after,
+            focused_window_id,
+            parent_tail_revalidated: parent_frame_ok
+                && parent_relation_ok
+                && parent_tail_revalidated,
+            children_tail_revalidated,
+            focus_tail_revalidated,
+            child_tail_revalidated,
+        };
+        let proof = build_attached_sheet_proof_payload(&facts);
+        for child in children {
+            CFRelease(child as CFTypeRef);
+        }
+        for candidate in windows {
+            CFRelease(candidate as CFTypeRef);
+        }
+        CFRelease(app as CFTypeRef);
+        proof
+    }
+}
