 use core_foundation::{array::CFArray, base::TCFType, string::CFString as CFStr};
 
+/// Copy an AX element-array attribute without collapsing read failures or
+/// malformed results into an empty collection. Returned elements are retained
+/// and must be released by the caller.
+///
+/// # Safety
+/// `element` must remain valid for the duration of the AX call.
+pub unsafe fn copy_element_array_attr_checked(
+    element: AXUIElementRef,
+    attr_name: &str,
+) -> Result<Vec<AXUIElementRef>, AXError> {
+    let attr = CFStr::new(attr_name);
+    let mut value: CFTypeRef = std::ptr::null();
+    let error = AXUIElementCopyAttributeValue(element, attr.as_concrete_TypeRef(), &mut value);
+    if error != kAXErrorSuccess || value.is_null() {
+        if !value.is_null() {
+            CFRelease(value);
+        }
+        return Err(if error == kAXErrorSuccess {
+            kAXErrorFailure
+        } else {
+            error
+        });
+    }
+    if core_foundation::base::CFGetTypeID(value) != CFArray::<CFTypeRef>::type_id() {
+        CFRelease(value);
+        return Err(kAXErrorFailure);
+    }
+    let array = CFArray::<CFTypeRef>::wrap_under_create_rule(value as _);
+    let ax_type_id = AXUIElementGetTypeID();
+    let mut children = Vec::with_capacity(array.len() as usize);
+    for index in 0..array.len() {
+        let Some(item_ref) = array.get(index) else {
+            for child in children {
+                CFRelease(child as CFTypeRef);
+            }
+            return Err(kAXErrorFailure);
+        };
+        let item = *item_ref;
+        if item.is_null() || core_foundation::base::CFGetTypeID(item) != ax_type_id {
+            for child in children {
+                CFRelease(child as CFTypeRef);
+            }
+            return Err(kAXErrorFailure);
+        }
+        CFRetain(item);
+        children.push(item as AXUIElementRef);
+    }
+    Ok(children)
+}
