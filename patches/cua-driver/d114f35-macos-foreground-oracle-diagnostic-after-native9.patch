+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn diagnostic_gate_stays_held_until_blocked_worker_exits() {
+        static GATE: DiagnosticGate = DiagnosticGate::new();
+        let permit = GATE.try_acquire().expect("first worker acquires gate");
+        let (sender, receiver) = mpsc::sync_channel(1);
+        let worker = std::thread::spawn(move || {
+            let _permit = permit;
+            std::thread::sleep(Duration::from_millis(40));
+            let _ = sender.send(());
+        });
+        assert_eq!(
+            receiver.recv_timeout(Duration::from_millis(5)),
+            Err(mpsc::RecvTimeoutError::Timeout),
+            "caller times out while the diagnostic worker remains blocked"
+        );
+        assert!(
+            GATE.try_acquire().is_none(),
+            "no duplicate worker while timed-out work remains active"
+        );
+        receiver.recv_timeout(Duration::from_secs(1)).unwrap();
+        worker.join().unwrap();
+        assert!(
+            GATE.try_acquire().is_some(),
+            "permit releases on worker exit"
+        );
+    }
