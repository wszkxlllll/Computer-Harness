+/// Read the current WindowServer front process while retaining only an opaque
+/// in-memory token for a before/after stability comparison. The token must
+/// never be serialized; callers should publish only `matches_target` and the
+/// stability result.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct FrontProcessObservation {
+    pub(crate) matches_target: bool,
+    token: [u8; 8],
+}
+
+impl FrontProcessObservation {
+    pub(crate) fn same_process(self, other: Self) -> bool {
+        self.token == other.token
+    }
+}
+
+pub(crate) fn observe_front_process(
+    target_pid: libc::pid_t,
+    target_wid: u32,
+) -> Option<FrontProcessObservation> {
+    let get_front = get_front_process_fn()?;
+    let mut front_psn = [0u8; 8];
+    if unsafe { get_front(front_psn.as_mut_ptr() as *mut c_void) } != 0 {
+        return None;
+    }
+    let mut target_psn = [0u8; 8];
+    if !get_process_psn_for_window(target_wid, target_pid, &mut target_psn) {
+        return None;
+    }
+    Some(FrontProcessObservation {
+        matches_target: front_psn == target_psn,
+        token: front_psn,
+    })
+}
