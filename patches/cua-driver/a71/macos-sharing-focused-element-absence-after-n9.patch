+            let missing = diagnostic(&without_focused_element(fixture.clone(), false));
+            let unsupported = diagnostic(&without_focused_element(fixture, true));
+            for same in [&exact, &missing, &unsupported] {
+                assert!(confirm(same, same).is_excluded());
+                assert_eq!(confirm(same, same).point_occlusion_policy, "retained");
+            }
+            for (first, second) in [
+                (&missing, &unsupported),
+                (&unsupported, &missing),
+                (&exact, &missing),
+                (&missing, &exact),
+                (&exact, &unsupported),
+                (&unsupported, &exact),
+            ] {
+                assert_eq!(confirm(first, second).reason, Reason::FreshTailMismatch);
+                assert!(!confirm(first, second).is_excluded());
+            }
+            let mut changed = missing.clone();
+            changed.focused_element_direct_status = "read_error";
+            assert!(!confirm(&missing, &changed).is_excluded());
