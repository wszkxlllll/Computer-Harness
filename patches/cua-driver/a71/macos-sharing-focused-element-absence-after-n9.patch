+fn focus_signature_matches(
+    prior: &ClassificationDiagnostic,
+    rechecked: &ClassificationDiagnostic,
+) -> bool {
+    prior.focused_window_status == "value"
+        && rechecked.focused_window_status == "value"
+        && prior.focused_element_direct_status == rechecked.focused_element_direct_status
+        && prior.focused_element_status == rechecked.focused_element_status
+        && prior.focus_proof_source == rechecked.focus_proof_source
+        && match prior.focus_proof_source {
+            FocusProofSource::ExactFocusedElement => {
+                prior.focused_element_direct_status == "value"
+                    && prior.focused_element_status == "value"
+            }
+            FocusProofSource::FocusedWindowAndFrontProcessNoValue => {
+                prior.focused_element_direct_status == "missing"
+                    && prior.focused_element_status == "missing"
+            }
+            FocusProofSource::FocusedWindowAndFrontProcessUnsupported => {
+                prior.focused_element_direct_status == "unsupported"
+                    && prior.focused_element_status == "unsupported"
+            }
+            FocusProofSource::None => false,
+        }
+}
