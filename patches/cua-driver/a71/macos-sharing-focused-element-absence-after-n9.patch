+fn direct_read_status<T>(value: &Checked<T>) -> Checked<()> {
+    match value {
+        Checked::Value(_) => Checked::Value(()),
+        Checked::Missing => Checked::Missing,
+        Checked::Unsupported => Checked::Unsupported,
+        Checked::ReadError => Checked::ReadError,
+        Checked::WrongType => Checked::WrongType,
+        Checked::Truncated => Checked::Truncated,
+    }
+}
+
+// Called only after the exact narrow sharing-control shape, identity,
+// semantics, nonfocus state and relations have all been proved. Some apps do
+// not expose AXFocusedUIElement at all. Only that direct typed absence can use
+// the existing exact focused-window/front-process proof instead; an owner,
+// relation or window-id read failure of a present element remains a refusal.
+fn focused_element_proof(e: &CandidateEvidence) -> Option<FocusProofSource> {
+    match (&e.focused_element_direct, &e.focused_element_window) {
+        (Checked::Value(()), Checked::Value(id)) if *id == e.focus_window_target => {
+            Some(FocusProofSource::ExactFocusedElement)
+        }
+        (Checked::Missing, Checked::Missing) | (Checked::Unsupported, Checked::Unsupported) => {
+            let content = e.focus_fallback_content.as_ref()?;
+            if !matches!(content.root, Checked::Value(false))
+                || !matches!(content.child, Checked::Value(false))
+            {
+                return None;
+            }
+            Some(if matches!(e.focused_element_direct, Checked::Missing) {
+                FocusProofSource::FocusedWindowAndFrontProcessNoValue
+            } else {
+                FocusProofSource::FocusedWindowAndFrontProcessUnsupported
+            })
+        }
+        _ => None,
+    }
+}
