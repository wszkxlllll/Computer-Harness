+/// accepts a window only when every required identity/geometry field is typed
+/// and the source enumeration itself is OnScreenOnly.
+fn point_snapshot_onscreen_any_layer() -> PointSnapshot {
+    use core_foundation::{
+        array::CFArray,
+        base::{CFGetTypeID, CFTypeRef, TCFType},
+        dictionary::CFDictionary,
+        string::CFString,
