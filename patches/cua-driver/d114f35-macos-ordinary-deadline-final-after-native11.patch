+fn verified_foreground_window(
+    windows: &[crate::windows::WindowInfo],
+    frontmost_before: Option<i32>,
+    focused_before: Option<u32>,
+    frontmost_after: Option<i32>,
+    focused_after: Option<u32>,
+) -> Option<(i32, u32)> {
+    let pid = frontmost_before?;
+    let window_id = focused_before?;
+    if frontmost_after != Some(pid) || focused_after != Some(window_id) {
+        return None;
+    }
+    let matches = windows
+        .iter()
+        .filter(|window| {
+            window.pid == pid
+                && window.window_id == window_id
+                && window.layer == 0
+                && window.is_on_screen
+        })
+        .count();
+    (matches == 1).then_some((pid, window_id))
 }
 
