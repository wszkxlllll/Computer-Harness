+fn point_cf_integer(
+    dict: &core_foundation::dictionary::CFDictionary<
+        *const std::os::raw::c_void,
+        *const std::os::raw::c_void,
+    >,
+    key: &str,
+) -> Option<i64> {
+    let value = point_cf_number(dict, key)?;
