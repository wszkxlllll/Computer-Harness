+    let status = loop {
+        match child.try_wait() {
+            Ok(Some(status)) => break status,
+            Ok(None) if started.elapsed() >= timeout => {
+                match kill_and_reap_child(&mut child) {
+                    Ok(status) => anyhow::bail!(
+                        "screencapture timed out after {} ms; termination was requested and owned child was reaped (status {status})",
+                        timeout.as_millis()
+                    ),
+                    Err(cleanup_error) => anyhow::bail!(
+                        "screencapture timed out after {} ms; owned child cleanup failed: {cleanup_error:#}",
+                        timeout.as_millis()
+                    ),
+                }
+            }
+            Ok(None) => std::thread::sleep(SHELL_CAPTURE_POLL_INTERVAL),
+            Err(error) => {
+                let cleanup = kill_and_reap_child(&mut child);
+                anyhow::bail!("screencapture wait failed: {error}; child cleanup: {cleanup:?}");
+            }
+        }
+    };
