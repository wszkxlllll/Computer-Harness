+fn kill_and_reap_child(child: &mut Child) -> anyhow::Result<ExitStatus> {
+    // `kill` may report that the child exited in the race with the deadline;
+    // wait remains the authoritative ownership/reaping step.
+    let kill_result = child.kill();
+    child.wait().map_err(|wait_error| {
+        anyhow::anyhow!(
+            "failed to reap owned screencapture child after kill {kill_result:?}: {wait_error}"
+        )
+    })
+}
+
+fn run_bounded_capture_command(
+    mut command: Command,
+    stderr_path: &std::path::Path,
+    timeout: Duration,
+) -> anyhow::Result<BoundedCommandOutput> {
+    let stderr_file = OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .mode(0o600)
+        .open(stderr_path)?;
+    command
+        .stdout(Stdio::null())
+        .stderr(Stdio::from(stderr_file));
+    let started = Instant::now();
+    let mut child = command
+        .spawn()
+        .map_err(|error| anyhow::anyhow!("screencapture launch failed: {error}"))?;
