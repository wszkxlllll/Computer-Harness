+    use core_foundation::{
+        base::{CFGetTypeID, TCFType},
+        number::CFNumber,
+        string::CFString,
+    };
+    use std::os::raw::c_void;
+    let key = CFString::new(key);
+    let value = *dict.find(key.as_concrete_TypeRef() as *const c_void)?;
+    if unsafe { CFGetTypeID(value) } != CFNumber::type_id() {
+        return None;
+    }
+    unsafe { CFNumber::wrap_under_get_rule(value as _).to_f64() }
