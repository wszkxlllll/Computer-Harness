+fn classify_list_windows_row(
+    layer: Option<i32>,
+    pid: Option<i32>,
+    is_on_screen: Option<bool>,
+    scope: ListWindowsScope,
+) -> ScopedRowDisposition {
+    let Some(layer) = layer else {
+        return ScopedRowDisposition::Unknown;
+    };
+    if layer != 0 {
+        return ScopedRowDisposition::Excluded;
+    }
+    let Some(pid) = pid.filter(|pid| *pid > 0) else {
+        return ScopedRowDisposition::Unknown;
+    };
+    if scope.pid.is_some_and(|scope_pid| scope_pid != pid) {
+        return ScopedRowDisposition::Excluded;
+    }
+    let Some(is_on_screen) = is_on_screen else {
+        return ScopedRowDisposition::Unknown;
+    };
+    if scope.on_screen_only && !is_on_screen {
+        return ScopedRowDisposition::Excluded;
+    }
+    ScopedRowDisposition::Included
