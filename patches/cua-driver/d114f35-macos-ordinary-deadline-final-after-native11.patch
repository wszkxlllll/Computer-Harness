+            }
+            let bounds: CFDictionary<*const c_void, *const c_void> =
+                unsafe { CFDictionary::wrap_under_get_rule(v as _) };
+            let coord = |key: &str| -> Option<f64> { point_cf_number(&bounds, key) };
+            Some(WindowBounds {
+                x: coord("X")?,
+                y: coord("Y")?,
+                width: coord("Width")?,
+                height: coord("Height")?,
+            })
+        };
+        let raw_onscreen = point_cf_onscreen(&dict);
+        let pid = number("kCGWindowOwnerPID").and_then(|v| i32::try_from(v).ok());
+        let window_id = number("kCGWindowNumber").and_then(|v| u32::try_from(v).ok());
+        let identity = pid
+            .zip(window_id)
+            .filter(|(pid, window_id)| *pid > 0 && *window_id > 0);
+        let Some((pid, window_id)) = identity else {
+            malformed += 1;
+            unusable_rows.push(PointSnapshotUnusableRow {
+                identity: None,
+                z_index,
+                raw_is_on_screen: raw_onscreen,
+            });
+            continue;
+        };
+        if !seen.insert((pid, window_id)) {
+            malformed += 1;
+            duplicate_identities.push((pid, window_id));
+            unusable_rows.push(PointSnapshotUnusableRow {
+                identity: Some((pid, window_id)),
+                z_index,
+                raw_is_on_screen: raw_onscreen,
+            });
+            continue;
+        }
+        let layer = number("kCGWindowLayer").and_then(|v| i32::try_from(v).ok());
+        let bounds = bounds();
+        let (Some(layer), Some(bounds)) = (layer, bounds) else {
+            malformed += 1;
+            unusable_rows.push(PointSnapshotUnusableRow {
+                identity: Some((pid, window_id)),
+                z_index,
+                raw_is_on_screen: raw_onscreen,
+            });
+            continue;
+        };
+        if !bounds_are_usable(&bounds) {
+            malformed += 1;
+            unusable_rows.push(PointSnapshotUnusableRow {
+                identity: Some((pid, window_id)),
+                z_index,
+                raw_is_on_screen: raw_onscreen,
+            });
+            continue;
+        }
+        windows.push(PointSnapshotWindow {
+            pid,
+            window_id,
+            layer,
+            z_index,
+            bounds,
+            raw_is_on_screen: raw_onscreen,
+        });
+    }
+    PointSnapshot {
+        windows,
+        unusable_rows,
+        duplicate_identities,
+        raw_row_count: Some(total),
+        malformed_row_count: malformed,
+        read_status: "ok",
+    }
 }
 
