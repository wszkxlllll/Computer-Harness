+
+fn bounded_command_stderr(path: &std::path::Path) -> anyhow::Result<(Vec<u8>, bool)> {
+    let file = File::open(path)?;
+    let file_len = file.metadata()?.len();
+    let mut stderr = Vec::with_capacity(MAX_SHELL_CAPTURE_STDERR_BYTES as usize);
+    file.take(MAX_SHELL_CAPTURE_STDERR_BYTES)
+        .read_to_end(&mut stderr)?;
+    Ok((stderr, file_len > MAX_SHELL_CAPTURE_STDERR_BYTES))
