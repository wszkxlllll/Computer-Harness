+fn project_name_presence(names: &Checked<Vec<String>>, attribute: &str) -> Checked<bool> {
+    match names {
+        Checked::Value(names) => Checked::Value(names.iter().any(|name| name == attribute)),
+        Checked::Missing => Checked::Missing,
+        Checked::Unsupported => Checked::Unsupported,
+        Checked::ReadError => Checked::ReadError,
+        Checked::WrongType => Checked::WrongType,
+        Checked::Truncated => Checked::Truncated,
+    }
+}
+
+fn project_attribute_names_result(result: Result<Vec<String>, i32>) -> Checked<Vec<String>> {
+    match result {
+        Ok(names) if names.len() <= MAX_ATTRIBUTE_NAMES => Checked::Value(names),
+        Ok(_) => Checked::Truncated,
+        Err(kAXErrorNoValue) => Checked::Missing,
+        Err(kAXErrorAttributeUnsupported) => Checked::Unsupported,
+        Err(_) => Checked::ReadError,
+    }
+}
+
+fn project_collection_content(_attribute: &str, result: Checked<bool>) -> Checked<bool> {
+    // A successful collection read reaches this projection as content=true
+    // only when nonempty/unauthorized; NoValue and all errors stay unknown.
+    result
+}
