+fn inventory_evidence(
+    enumeration: &crate::windows::WindowEnumeration,
+    pid_filter: Option<i32>,
+    on_screen_only: bool,
+    row_count: usize,
+    foreground: Option<(i32, u32)>,
+) -> Value {
+    let complete = enumeration.read_status == "ok"
+        && enumeration.raw_row_count == Some(row_count)
+        && enumeration.malformed_row_count == 0;
+    serde_json::json!({
+        "version": "macos-window-inventory-v1",
+        "scope": {
+            "layer": 0,
+            "pid": pid_filter,
+            "on_screen_only": on_screen_only,
+        },
+        "complete": complete,
+        "truncated": false,
+        "read_status": enumeration.read_status,
+        "raw_row_count": enumeration.raw_row_count,
+        "row_count": row_count,
+        "malformed_row_count": enumeration.malformed_row_count,
+        "foreground": (complete.then_some(foreground).flatten()).map(|(pid, window_id)| serde_json::json!({
+            "status": "verified",
+            "pid": pid,
+            "window_id": window_id,
+        })),
+    })
+}
