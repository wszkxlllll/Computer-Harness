+            windows: Vec::new(),
+            unusable_rows: Vec::new(),
+            duplicate_identities: Vec::new(),
+            raw_row_count: None,
+            malformed_row_count: 0,
+            read_status: "unavailable",
+        };
+    }
+    let raw: CFArray<CFTypeRef> = unsafe { CFArray::wrap_under_create_rule(raw_ref as _) };
+    let total = raw.len() as usize;
+    let dict_type = CFDictionary::<*const c_void, *const c_void>::type_id();
+    let mut windows = Vec::with_capacity(total);
+    let mut malformed = 0usize;
+    let mut seen = std::collections::HashSet::new();
+    let mut unusable_rows = Vec::new();
+    let mut duplicate_identities = Vec::new();
+    for (idx, item) in raw.iter().enumerate() {
+        let item = *item;
+        let z_index = z_index_from_front_to_back(total, idx);
+        if unsafe { CFGetTypeID(item) } != dict_type {
+            malformed += 1;
+            unusable_rows.push(PointSnapshotUnusableRow {
+                identity: None,
+                z_index,
+                raw_is_on_screen: RawOnscreenKey::Missing,
+            });
+            continue;
+        }
+        let dict: CFDictionary<*const c_void, *const c_void> =
+            unsafe { CFDictionary::wrap_under_get_rule(item as _) };
+        let value = |key: &str| {
+            let key = CFString::new(key);
+            dict.find(key.as_concrete_TypeRef() as *const c_void)
+                .map(|v| *v)
+        };
+        let number = |key: &str| point_cf_integer(&dict, key);
+        let bounds = || -> Option<WindowBounds> {
+            let v = value("kCGWindowBounds")?;
+            if unsafe { CFGetTypeID(v) } != dict_type {
