# 普通使用：运行 scripts/setup-mobile.ps1，按提示填写即可自动生成 .env。
# 手动配置：将本文件复制为 .env，填好下面五项。不要提交或分享实际 .env。

# 默认 GLM 模型的 API 密钥
ZHIPUAI_API_KEY=

# 服务维护者提供的连接资料；两个地址填写同一个 HTTPS 入口。
HARNESS_RELAY_URL=https://relay.example.com
HARNESS_RELAY_PUBLIC_ORIGIN=https://relay.example.com
HARNESS_HOST_ID=
HARNESS_RELAY_CREDENTIAL=

# 可选：使用 Qwen 模型或语音识别时再取消注释并填写。
# DASHSCOPE_API_KEY=
# DASHSCOPE_WORKSPACE_ID=
