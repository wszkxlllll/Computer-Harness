+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct FrontmostRowDiagnostic {
+    state: &'static str,
+    pid: Option<i32>,
+    window_id: Option<u32>,
+    layer: Option<i32>,
+    z: Option<u32>,
+    is_on_screen: Option<bool>,
+    target_pid_relation: &'static str,
+    target_window_id_relation: &'static str,
+}
+
+impl FrontmostRowDiagnostic {
+    fn from_row(
+        row: Option<&crate::windows::WindowInfo>,
+        target_pid: i32,
+        target_window_id: u32,
+    ) -> Self {
+        let Some(row) = row else {
+            return Self {
+                state: "missing",
+                pid: None,
+                window_id: None,
+                layer: None,
+                z: None,
+                is_on_screen: None,
+                target_pid_relation: "unknown",
+                target_window_id_relation: "unknown",
+            };
+        };
+        let z = u32::try_from(row.z_index).ok();
+        if row.pid <= 0 || row.window_id == 0 || row.z_index == 0 || z.is_none() {
+            return Self {
+                state: "invalid",
+                pid: None,
+                window_id: None,
+                layer: None,
+                z: None,
+                is_on_screen: None,
+                target_pid_relation: "unknown",
+                target_window_id_relation: "unknown",
+            };
+        }
+
+        Self {
+            state: "present",
+            pid: Some(row.pid),
+            window_id: Some(row.window_id),
+            layer: Some(row.layer),
+            z,
+            is_on_screen: Some(row.is_on_screen),
+            target_pid_relation: if row.pid == target_pid {
+                "same"
+            } else {
+                "different"
+            },
+            target_window_id_relation: if row.window_id == target_window_id {
+                "same"
+            } else {
+                "different"
+            },
+        }
+    }
+
+    fn as_json(self) -> Value {
+        json!({
+            "schema": "cua.frontmost_window_diagnostic.v1",
+            "source": "observe_exact_window_existing_visible_windows_snapshot",
+            "state": self.state,
+            "frontmost_window_pid": self.pid,
+            "frontmost_window_id": self.window_id,
+            "layer": self.layer,
+            "z": self.z,
+            "is_on_screen": self.is_on_screen,
+            "target_pid_relation": self.target_pid_relation,
+            "target_window_id_relation": self.target_window_id_relation,
+        })
+    }
 }
 
