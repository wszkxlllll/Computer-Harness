{
  "name": "computer-harness",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=18.19.0"
  },
  "scripts": {
    "build": "pnpm run typecheck",
    "typecheck": "tsc -b && pnpm exec tsc --noEmit -p spikes/cua-driver/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe:cua": "pnpm --filter @computer-harness/cua-driver-spike probe",
    "probe:cua:daemon": "pnpm --filter @computer-harness/cua-driver-spike exec tsx probe-daemon.ts",
    "probe:cua:capabilities": "pnpm --filter @computer-harness/cua-driver-spike probe:capabilities"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
