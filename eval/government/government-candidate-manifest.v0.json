  "taskFamilies": [
    {
      "id": "find_service_entry",
      "split": "development",
      "difficulty": "easy",
      "clients": ["provincial_gov_platform", "national_gov_platform"],
      "goalTemplate": "在政务服务平台查询“{{serviceType}}”的办理入口，记录办理方式（网上办理/现场办理）、所需材料清单（至少列出 3 项主要材料）、承诺办结时限。在最终回复交付查询结果，不需要创建文件。",
      "manualChecks": [
        "确认办理方式准确（网上/现场/两者皆可）。",
        "材料清单至少包含 3 项主要材料。",
        "承诺时限单位明确（工作日/自然日）。"
      ],
      "variants": [
        {
          "id": "v1",
          "serviceType": "个体工商户设立登记",
          "expectedMaterials": ["身份证明", "经营场所证明", "申请表"],
          "expectedTimelimit": "1-3 个工作日"
        },
        {
          "id": "v2",
          "serviceType": "灵活就业人员社保登记",
          "expectedMaterials": ["身份证", "户口本或居住证", "登记表"],
          "expectedTimelimit": "即时办结或 1 个工作日"
        }
      ]
    },
    {
      "id": "query_material_specification",
      "split": "heldout",
      "difficulty": "easy",
      "clients": ["municipal_gov_platform", "specialized_app"],
      "goalTemplate": "查询“{{licenseType}}”申请材料的详细规范，列出每项材料的格式要求（原件/复印件、份数、是否需盖章），生成材料准备核对表。在最终回复交付核对表，不需要创建文件。",
      "manualChecks": [
        "每项材料明确标注原件/复印件。",
        "份数准确（如\"一式两份\"）。",
        "盖章要求明确（需/不需/特定情况需）。"
      ],
      "variants": [
        {
          "id": "v1",
          "licenseType": "食品经营许可证",
          "expectedItems": ["营业执照复印件", "经营场所平面图原件", "健康证复印件"]
        },
        {
          "id": "v2",
          "licenseType": "道路运输经营许可",
          "expectedItems": ["申请表原件", "车辆行驶证复印件", "驾驶员资格证复印件"]
        }
      ]
    },
    {
      "id": "locate_applicable_process",
      "split": "development",
      "difficulty": "medium",
      "clients": ["provincial_gov_platform"],
      "goalTemplate": "用户条件：{{userCondition}}。请定位需要办理的许可证类型及先后顺序，说明哪些可以并联办理。在最终回复交付分析结果。",
      "manualChecks": [
        "许可证类型准确（如营业执照+食品经营许可）。",
        "先后顺序合理（营业执照通常在前）。",
        "并联办理判断正确（根据实际平台能力）。"
      ],
      "variants": [
        {
          "id": "v1",
          "userCondition": "注册资本 50 万元、经营范围含预包装食品销售的有限公司",
          "expectedLicenses": ["营业执照", "食品经营许可证"],
          "expectedOrder": "营业执照 → 食品经营许可证"
        },
        {
          "id": "v2",
          "userCondition": "个体工商户、经营餐饮服务",
          "expectedLicenses": ["营业执照", "食品经营许可证"],
          "parallelPossible": "部分地区支持营业执照与食品许可并联办理"
        }
      ]
    },
    {
      "id": "generate_material_checklist",
      "split": "development",
      "difficulty": "medium",
      "clients": ["provincial_gov_platform", "municipal_gov_platform"],
      "goalTemplate": "为“{{permitType}}”生成材料核对表，从办事指南提取所有必需材料，逐项标注：材料名称、来源（申请人自备/政府部门出具）、格式（原件/复印件）、份数。在最终回复交付核对表。",
      "manualChecks": [
        "材料数量≥8 项（复杂许可）。",
        "来源标注准确（自备/政府部门）。",
        "格式与份数明确。"
      ],
      "variants": [
        {
          "id": "v1",
          "permitType": "商品房预售许可",
          "expectedMaterialCount": 10
        },
        {
          "id": "v2",
          "permitType": "建设工程规划许可证",
          "expectedMaterialCount": 8
        }
      ]
    },
    {
