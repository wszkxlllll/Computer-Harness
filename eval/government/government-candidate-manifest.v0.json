      "split": "development",
      "difficulty": "medium",
      "clients": ["provincial_gov_platform"],
      "goalTemplate": "填写“{{applicationType}}”申请表（包括{{requiredSections}}），保存为草稿（不提交），确认在“我的草稿”中可以查询到该草稿，记录草稿编号与保存时间。",
      "manualChecks": [
        "必填项已填写（测试数据）。",
        "草稿保存成功（显示草稿编号）。",
        "未点击\"提交申请\"。"
      ],
      "variants": [
        {
          "id": "v1",
          "applicationType": "个体工商户设立登记",
          "requiredSections": "经营者信息、字号名称、经营范围、经营场所"
        },
        {
          "id": "v2",
          "applicationType": "有限公司设立登记",
          "requiredSections": "股东信息、注册资本、经营范围、注册地址"
